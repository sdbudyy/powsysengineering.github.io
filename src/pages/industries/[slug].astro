---
import { withBase } from '../../lib/url';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import KnowledgeMini from '../../components/KnowledgeMini.astro';
import ProjectMini from '../../components/ProjectMini.astro';
import { site } from '../../data/site';
import { industries, projects } from '../../data/content';
import { industryPages, type IndustryPage } from '../../data/industry-pages';
import { industryHeroes } from '../../data/industry-images';
import { serviceLinks, industryServices, getService, getEntry } from '../../data/relations';

export function getStaticPaths() {
  return industries.map((industry) => ({
    params: { slug: industry.slug },
    props: { industry, page: industryPages[industry.slug] },
  }));
}

interface Props {
  industry: (typeof industries)[number];
  page: IndustryPage;
}

const { industry, page } = Astro.props;
const hero = industryHeroes[industry.slug];

const relatedServices = (industryServices[industry.slug] ?? []).map(getService);

/* Articles and projects reached through the services this industry uses —
   deduplicated, so an article tied to two services still appears once. */
const relatedKnowledge = [
  ...new Set(
    (industryServices[industry.slug] ?? []).flatMap((s) => serviceLinks[s]?.knowledge ?? [])
  ),
]
  .slice(0, 3)
  .map(getEntry);

const relatedProjects = [
  ...new Set(
    (industryServices[industry.slug] ?? []).flatMap((s) => serviceLinks[s]?.projects ?? [])
  ),
]
  .map((slug) => projects.find((p) => p.slug === slug)!)
  .filter(Boolean);

const totalCapabilities = page.capabilityGroups.reduce((n, g) => n + g.items.length, 0);

const url = `${site.url}/industries/${industry.slug}`;

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${url}#service`,
  name: `Electrical engineering for the ${industry.name} sector`,
  description: page.intro,
  url,
  provider: { '@id': `${site.url}/#organization` },
  areaServed: site.areaServed,
  serviceType: `${industry.name} electrical engineering`,
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: `${industry.name} capabilities`,
    itemListElement: page.capabilityGroups.map((group) => ({
      '@type': 'OfferCatalog',
      name: group.title,
      itemListElement: group.items.map((item) => ({
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: item },
      })),
    })),
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: page.faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
    { '@type': 'ListItem', position: 2, name: 'Industries', item: `${site.url}/industries` },
    { '@type': 'ListItem', position: 3, name: industry.name, item: url },
  ],
};
---

<BaseLayout
  title={`${industry.name} Engineering Services | PowSys Engineering`}
  description={page.intro.slice(0, 300)}
  schema={[serviceSchema, faqSchema, breadcrumbSchema]}
>
  <!-- =====================================================================
       FULL-BLEED HERO
  ====================================================================== -->
  <section class="relative isolate min-h-[68svh] overflow-hidden">
    <Image
      src={hero.src}
      alt={hero.alt}
      widths={[640, 1024, 1600, 1900]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 -z-20 h-full w-full object-cover"
    />

    <div
      class="absolute inset-0 -z-10"
      style="background: linear-gradient(165deg, rgba(9,22,58,0.62) 0%, rgba(12,32,80,0.80) 45%, rgba(9,22,58,0.95) 100%);"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute -right-32 -top-24 -z-10 h-[34rem] w-[34rem] rounded-full opacity-60 blur-3xl"
      style="background: radial-gradient(circle, rgba(176,208,56,0.45) 0%, transparent 68%);"
      aria-hidden="true"
    >
    </div>

    <div class="mx-auto flex min-h-[68svh] max-w-7xl flex-col justify-end px-5 pb-14 pt-32 lg:px-8 lg:pb-20 lg:pt-40">
      <nav aria-label="Breadcrumb">
        <ol class="flex flex-wrap items-center gap-2 text-xs text-white/60">
          <li><a href={withBase('/')} class="transition-colors hover:text-lime">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href={withBase('/industries')} class="transition-colors hover:text-lime">Industries</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-white/85">{industry.name}</li>
        </ol>
      </nav>

      <h1 class="mt-6 max-w-4xl text-[clamp(2.2rem,5.4vw,4.2rem)] leading-[1.04] text-white">
        {industry.name}
      </h1>

      <p class="mt-5 max-w-xl text-lg leading-relaxed text-white/80">{page.tagline}</p>

      {/* Factual counters — derived from the capability lists, not invented */}
      <dl class="mt-10 flex flex-wrap gap-x-10 gap-y-5 border-t border-white/15 pt-7">
        <div>
          <dt class="text-[0.7rem] uppercase tracking-[0.14em] text-white/55">Capabilities</dt>
          <dd class="mt-1 font-display text-3xl font-bold text-lime">
            <span data-count-to={totalCapabilities}>{totalCapabilities}</span>
          </dd>
        </div>
        <div>
          <dt class="text-[0.7rem] uppercase tracking-[0.14em] text-white/55">Service lines</dt>
          <dd class="mt-1 font-display text-3xl font-bold text-lime">
            <span data-count-to={relatedServices.length}>{relatedServices.length}</span>
          </dd>
        </div>
        <div>
          <dt class="text-[0.7rem] uppercase tracking-[0.14em] text-white/55">Permits held</dt>
          <dd class="mt-1 font-display text-3xl font-bold text-lime">
            <span data-count-to="3">3</span>
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- =====================================================================
       INTRO + CHALLENGE
  ====================================================================== -->
  <section class="relative py-20 lg:py-24" aria-labelledby="intro-heading">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <p class="reveal eyebrow">Overview</p>
          <h2 id="intro-heading" class="reveal mt-5 text-[clamp(1.8rem,3.4vw,2.7rem)] leading-[1.08]" style="--i:1">
            What we do here.
          </h2>
        </div>

        <div class="lg:col-span-7">
          <p class="reveal text-xl leading-relaxed text-ink lg:text-[1.25rem]">{page.intro}</p>

          <div
            class="reveal mt-8 rounded-[var(--radius-card)] border-l-[3px] bg-brand-50/60 p-6"
            style="--i:1; border-left-color: var(--color-lime);"
          >
            <p class="font-display text-[0.72rem] font-bold uppercase tracking-[0.13em] text-brand">
              Why this sector is different
            </p>
            <p class="mt-3 leading-relaxed text-ink-soft">{page.challenge}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =====================================================================
       CAPABILITY GROUPS
  ====================================================================== -->
  <section class="relative py-16 lg:py-20" aria-labelledby="capabilities-heading">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="max-w-2xl">
        <p class="reveal eyebrow">Capabilities</p>
        <h2 id="capabilities-heading" class="reveal mt-5 text-[clamp(1.8rem,3.4vw,2.7rem)] leading-[1.08]" style="--i:1">
          {totalCapabilities} capabilities, in four groups.
        </h2>
      </div>

      <div class="mt-12 grid gap-5 sm:grid-cols-2">
        {page.capabilityGroups.map((group, i) => (
          <article class="reveal card p-7" style={`--i:${i % 2}`}>
            <div class="flex items-center gap-3">
              <span
                class="grid h-9 w-9 shrink-0 place-items-center rounded-lg font-display text-xs font-bold text-white"
                style="background: linear-gradient(140deg, var(--color-brand), var(--color-brand-400));"
                aria-hidden="true"
              >
                {i + 1}
              </span>
              <h3 class="font-display text-lg font-bold text-ink">{group.title}</h3>
              <span class="ml-auto text-xs font-semibold text-ink-muted">{group.items.length}</span>
            </div>

            <ul class="mt-5 space-y-2.5">
              {group.items.map((item) => (
                <li class="flex gap-3 text-sm leading-relaxed text-ink-soft">
                  <span class="mt-[0.45rem] h-1.5 w-1.5 shrink-0 rounded-full bg-lime" aria-hidden="true"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- =====================================================================
       SERVICES USED HERE
  ====================================================================== -->
  <section class="relative py-16 lg:py-20" aria-labelledby="services-heading">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="max-w-2xl">
        <p class="reveal eyebrow">Service lines</p>
        <h2 id="services-heading" class="reveal mt-5 text-[clamp(1.8rem,3.4vw,2.7rem)] leading-[1.08]" style="--i:1">
          How that work is delivered.
        </h2>
      </div>

      <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {relatedServices.map((svc, i) => (
          <li class="reveal" style={`--i:${i}`}>
            <a
              href={withBase(`/services/${svc.slug}`)}
              class="card group flex h-full flex-col p-6"
            >
              <h3 class="font-display text-base font-bold text-ink transition-colors group-hover:text-brand">
                {svc.title}
              </h3>
              <p class="mt-2 font-display text-[0.7rem] font-bold uppercase tracking-[0.11em] text-lime-600">
                {svc.threeWords}
              </p>
              <p class="mt-4 flex-1 text-sm leading-relaxed text-ink-soft">{svc.summary}</p>
              <span class="mt-5 inline-flex items-center gap-1.5 text-xs font-semibold text-brand">
                <span class="link-draw relative">See the service</span>
                <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- =====================================================================
       RELATED WORK + READING
  ====================================================================== -->
  {(relatedProjects.length > 0 || relatedKnowledge.length > 0) && (
    <section class="relative py-16 lg:py-20" aria-labelledby="related-heading">
      <div class="mx-auto max-w-7xl px-5 lg:px-8">
        <h2 id="related-heading" class="sr-only">Related work and reading</h2>

        <div class="grid gap-12 lg:grid-cols-2 lg:gap-10">
          {relatedProjects.length > 0 && (
            <div>
              <p class="reveal eyebrow">Related work</p>
              <ul class="mt-6 space-y-4">
                {relatedProjects.map((p, i) => (
                  <li class="reveal" style={`--i:${i}`}>
                    <ProjectMini project={p} panelId={`ind-proj-${industry.slug}-${p.slug}`} />
                  </li>
                ))}
              </ul>
            </div>
          )}

          {relatedKnowledge.length > 0 && (
            <div>
              <p class="reveal eyebrow">Related reading</p>
              <ul class="mt-6 space-y-3">
                {relatedKnowledge.map((entry, i) => (
                  <li class="reveal" style={`--i:${i}`}>
                    <KnowledgeMini entry={entry} />
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- =====================================================================
       FAQ
  ====================================================================== -->
  <section class="relative py-16 lg:py-20" aria-labelledby="faq-heading">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-4">
          <p class="reveal eyebrow">{industry.name} questions</p>
          <h2 id="faq-heading" class="reveal mt-5 text-[clamp(1.8rem,3.4vw,2.7rem)] leading-[1.08]" style="--i:1">
            Common questions.
          </h2>
        </div>

        <div class="lg:col-span-8">
          <dl class="space-y-3">
            {page.faqs.map((f, i) => (
              <div class="reveal" style={`--i:${i}`}>
                <details class="card group overflow-hidden [&[open]]:border-brand-200">
                  <summary class="flex cursor-pointer list-none items-center justify-between gap-6 p-6 text-left [&::-webkit-details-marker]:hidden">
                    <dt class="font-display text-base font-bold text-ink transition-colors group-hover:text-brand">
                      {f.q}
                    </dt>
                    <span
                      class="grid h-8 w-8 shrink-0 place-items-center rounded-full border border-line text-brand transition-all duration-300 group-open:rotate-45 group-open:border-brand-200 group-open:bg-brand-50"
                      aria-hidden="true"
                    >
                      <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                        <path d="M6 1v10M1 6h10" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                      </svg>
                    </span>
                  </summary>
                  <dd class="px-6 pb-6 text-[0.95rem] leading-relaxed text-ink-soft">{f.a}</dd>
                </details>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </div>
  </section>

  <!-- =====================================================================
       NEXT INDUSTRY + CTA
  ====================================================================== -->
  <section class="relative pb-24 lg:pb-32">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div
        class="reveal relative isolate overflow-hidden rounded-[28px] px-6 py-14 text-center lg:px-16 lg:py-16"
        style="background: linear-gradient(135deg, #14357B 0%, #1A4194 45%, #2B57B0 100%);"
      >
        <div
          class="pointer-events-none absolute -right-24 -top-24 h-[26rem] w-[26rem] rounded-full opacity-45 blur-3xl"
          style="background: radial-gradient(circle, rgba(176,208,56,0.75) 0%, transparent 65%);"
          aria-hidden="true"
        >
        </div>

        <h2 class="relative mx-auto max-w-2xl text-[clamp(1.7rem,3.4vw,2.6rem)] leading-[1.08] text-white">
          Working on a {industry.name.toLowerCase()} project?
        </h2>
        <p class="relative mx-auto mt-4 max-w-xl leading-relaxed text-brand-100">
          Tell us what you are trying to achieve. We will tell you what it needs —
          including when the answer is less than you expected.
        </p>

        <div class="relative mt-8 flex flex-wrap justify-center gap-3">
          <a
            href={withBase('/contact')}
            class="rounded-xl bg-lime px-7 py-4 font-semibold text-brand-900 transition-all duration-300 hover:-translate-y-0.5 hover:bg-lime-300"
          >
            Start a conversation
          </a>
          <a
            href={withBase('/industries')}
            class="rounded-xl border border-white/30 px-7 py-4 font-semibold text-white transition-all duration-300 hover:-translate-y-0.5 hover:border-white/60 hover:bg-white/10"
          >
            All industries
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
