---
import { withBase } from '../../lib/url';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';
import { services, industries, process, serviceFaqs, tools } from '../../data/content';
import { serviceLinks, industryServices, getIndustry, getService } from '../../data/relations';

import imgDesign from '../../assets/images/distributor-design-900x600.jpg';
import imgCompliance from '../../assets/images/engineer-female-900x600.jpg';
import imgPm from '../../assets/images/engineering-study.jpg';
import imgCbm from '../../assets/images/engineer-male-900x600.jpg';
import imgData from '../../assets/images/datacenter-900x600.jpg';
import imgCommercial from '../../assets/images/clean-room-900x600.jpg';

/* Banner per service. Alt text describes what is actually in each photograph. */
const serviceMedia: Record<string, { src: ImageMetadata; alt: string }> = {
  'engineering-design': {
    src: imgDesign,
    alt: 'Close-up of an electrical schematic drawing with a pencil resting on it',
  },
  'compliance-verification': {
    src: imgCompliance,
    alt: 'Engineer in a hard hat and high-visibility vest on a site walkdown',
  },
  'project-management': {
    src: imgPm,
    alt: 'Two engineers reviewing a technical site drawing together',
  },
  'condition-based-maintenance': {
    src: imgCbm,
    alt: 'Technician in PowSys high-visibility PPE inspecting industrial machinery',
  },
  'data-centres': {
    src: imgData,
    alt: 'Rows of data centre server racks with structured network cabling',
  },
  'commercial-sector': {
    src: imgCommercial,
    alt: 'Interior of a commercial clean room with sealed wall panels and ceiling services',
  },
};

/* --- Structured data ----------------------------------------------------- */

const serviceCatalogSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${site.url}/#organization`,
  name: site.legalName,
  url: `${site.url}/services`,
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Electrical engineering services',
    itemListElement: services.map((s) => ({
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name: s.title,
        description: s.summary,
        serviceType: s.title,
        url: `${site.url}/services/${s.slug}`,
        provider: { '@id': `${site.url}/#organization` },
        areaServed: site.areaServed,
        hasOfferCatalog: {
          '@type': 'OfferCatalog',
          name: `${s.title} capabilities`,
          itemListElement: s.points.map((p) => ({
            '@type': 'Offer',
            itemOffered: { '@type': 'Service', name: p },
          })),
        },
      },
    })),
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: serviceFaqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
    { '@type': 'ListItem', position: 2, name: 'Services', item: `${site.url}/services` },
  ],
};

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'How PowSys Engineering delivers an electrical engineering project',
  description:
    'The five stages PowSys Engineering works through on an electrical engineering project, from defining the requirement to supporting the asset in service.',
  step: process.map((p, i) => ({
    '@type': 'HowToStep',
    position: i + 1,
    name: p.step,
    text: p.detail,
  })),
};
---

<BaseLayout
  title="Electrical Engineering Services Calgary | PowSys Engineering"
  description="Six electrical engineering service lines from PowSys Engineering, Calgary — design, compliance and verification, project management, condition-based maintenance, data centre and commercial solutions across Alberta, BC and Saskatchewan."
  schema={[serviceCatalogSchema, faqSchema, breadcrumbSchema, howToSchema]}
>
  <!-- =====================================================================
       HERO
  ====================================================================== -->
  <section class="relative isolate overflow-hidden pt-32 pb-16 lg:pt-40 lg:pb-20">
    <div
      class="pointer-events-none absolute -top-40 right-[-8%] -z-10 h-[44rem] w-[44rem] rounded-full opacity-70 blur-3xl"
      style="background: radial-gradient(circle, rgba(176,208,56,0.30) 0%, rgba(176,208,56,0.06) 45%, transparent 70%);"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute -left-[12%] top-24 -z-10 h-[36rem] w-[36rem] rounded-full opacity-70 blur-3xl"
      style="background: radial-gradient(circle, rgba(26,65,148,0.20) 0%, rgba(26,65,148,0.04) 48%, transparent 70%);"
      aria-hidden="true"
    >
    </div>

    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <nav aria-label="Breadcrumb" class="reveal">
        <ol class="flex items-center gap-2 text-xs text-ink-muted">
          <li><a href={withBase('/')} class="transition-colors hover:text-brand">Home</a></li>
          <li aria-hidden="true">/</li>
          <li class="font-medium text-ink-soft">Services</li>
        </ol>
      </nav>

      <p class="reveal eyebrow mt-6" style="--i:1">What we do</p>

      <h1 class="reveal mt-5 max-w-4xl text-[clamp(2.2rem,5vw,4rem)] leading-[1.05]" style="--i:2">
        Electrical engineering services, <span class="grad-text">end to end</span>.
      </h1>

      <p class="reveal mt-6 max-w-xl text-lg leading-relaxed text-ink-soft" style="--i:3">
        Six service lines covering the full life of an electrical asset. Take all
        of it, or the part you are missing.
      </p>

      {/* Jump navigation — animated, and the fastest route into a long page */}
      <ul class="reveal mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-3" style="--i:4">
        {services.map((s, i) => (
          <li>
            <a
              href={`#service-${s.slug}`}
              class="group flex items-center gap-4 rounded-xl border border-line bg-white/70 p-4 transition-all duration-300 hover:-translate-y-0.5 hover:border-brand-200 hover:bg-white hover:shadow-[0_14px_32px_-18px_rgba(26,65,148,0.4)]"
            >
              <span
                class="grid h-10 w-10 shrink-0 place-items-center rounded-lg bg-brand-50 font-display text-sm font-bold text-brand transition-colors duration-300 group-hover:bg-brand group-hover:text-white"
                aria-hidden="true"
              >
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="min-w-0">
                <span class="block text-sm font-bold text-ink transition-colors group-hover:text-brand">
                  {s.title}
                </span>
                <span class="mt-0.5 block truncate text-[0.72rem] font-semibold uppercase tracking-wider text-lime-600">
                  {s.threeWords}
                </span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- =====================================================================
       SERVICE DEEP DIVES — sticky rail + scroll-spy
  ====================================================================== -->
  <div class="mx-auto max-w-7xl px-5 pb-8 lg:px-8">
    <div class="lg:grid lg:grid-cols-12 lg:gap-12">
      {/* Sticky rail */}
      <aside class="hidden lg:col-span-3 lg:block">
        <nav id="service-rail" class="sticky top-28" aria-label="Services on this page">
          <p class="text-xs font-semibold uppercase tracking-[0.14em] text-ink-muted">
            On this page
          </p>
          <ul class="mt-4 space-y-1">
            {services.map((s) => (
              <li>
                <a
                  href={`#service-${s.slug}`}
                  data-rail-link={`service-${s.slug}`}
                  class="rail-link block rounded-lg border-l-2 border-line py-2 pl-4 text-sm font-medium text-ink-muted transition-all duration-300"
                >
                  {s.title}
                </a>
              </li>
            ))}
          </ul>

          <div class="mt-8 rounded-xl border border-line bg-white/70 p-5">
            <p class="font-display text-sm font-bold text-ink">Not sure which you need?</p>
            <p class="mt-2 text-xs leading-relaxed text-ink-soft">
              Describe the problem and we will tell you which service — or whether
              you need one at all.
            </p>
            <a
              href={withBase('/contact')}
              class="mt-4 inline-flex w-full items-center justify-center rounded-lg bg-brand px-4 py-2.5 text-xs font-semibold text-white transition-colors hover:bg-brand-700"
            >
              Ask an engineer
            </a>
          </div>
        </nav>
      </aside>

      {/* Sections */}
      <div class="lg:col-span-9">
        {services.map((s, i) => {
          const links = serviceLinks[s.slug];
          const media = serviceMedia[s.slug];
          return (
            <section
              id={`service-${s.slug}`}
              data-service-section
              class="scroll-mt-28 border-t border-line py-12 first:border-t-0 first:pt-0 lg:py-16 lg:first:pt-0"
              aria-labelledby={`service-${s.slug}-heading`}
            >
              <div class="reveal flex items-center gap-4">
                <span
                  class="grid h-11 w-11 shrink-0 place-items-center rounded-xl font-display text-sm font-bold text-white"
                  style="background: linear-gradient(140deg, var(--color-brand), var(--color-brand-400));"
                  aria-hidden="true"
                >
                  {String(i + 1).padStart(2, '0')}
                </span>
                <p class="font-display text-[0.78rem] font-bold uppercase tracking-[0.13em] text-lime-600">
                  {s.threeWords}
                </p>
              </div>

              <h2
                id={`service-${s.slug}-heading`}
                class="reveal mt-5 text-[clamp(1.75rem,3.4vw,2.7rem)] leading-[1.08]"
                style="--i:1"
              >
                {s.title}
              </h2>

              {/* Summary sits beside a small thumbnail rather than under a
                  full-width banner — keeps the first read short. */}
              <div class="reveal mt-5 flex flex-col gap-6 sm:flex-row sm:items-start" style="--i:2">
                <p class="max-w-xl flex-1 text-lg leading-relaxed text-ink-soft">
                  {s.summary}
                </p>

                <Image
                  src={media.src}
                  alt={media.alt}
                  widths={[240, 400, 480]}
                  sizes="(min-width: 640px) 15rem, 60vw"
                  loading="lazy"
                  class="aspect-[4/3] w-full max-w-[15rem] shrink-0 rounded-xl object-cover ring-1 ring-brand-900/10 transition-transform duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] hover:scale-[1.04]"
                />
              </div>

              {/* First three capabilities only. The rest expand on request. */}
              <div class="reveal mt-8" style="--i:1">
                <h3 class="font-display text-sm font-bold uppercase tracking-[0.13em] text-brand">
                  Key capabilities
                </h3>
                <ul class="mt-4 grid gap-x-8 gap-y-2.5 sm:grid-cols-2">
                  {s.points.slice(0, 3).map((p) => (
                    <li class="flex gap-3 text-[0.95rem] leading-relaxed text-ink-soft">
                      <span class="mt-[0.5rem] h-1.5 w-1.5 shrink-0 rounded-full bg-lime" aria-hidden="true"></span>
                      <span>{p}</span>
                    </li>
                  ))}
                </ul>
              </div>

              {/* The full scope, deliverables, FAQs and related material now
                  live on each service's own page. Repeating them here would be
                  duplicate content competing with the page that should rank. */}
              <div class="reveal mt-7 flex flex-wrap items-center gap-4">
                <a
                  href={withBase(`/services/${s.slug}`)}
                  class="group inline-flex items-center gap-2 rounded-xl bg-brand px-6 py-3 text-sm font-semibold text-white transition-all duration-300 hover:-translate-y-0.5 hover:bg-brand-700"
                >
                  Full details
                  <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
                </a>

                {links.industries.length > 0 && (
                  <p class="text-xs text-ink-muted">
                    Applied in{' '}
                    {links.industries.map((slug, n) => (
                      <>
                        {n > 0 && ', '}
                        <a
                          href={withBase(`/industries/${slug}`)}
                          class="font-medium text-brand transition-colors hover:text-lime-600"
                        >{getIndustry(slug).name}</a>
                      </>
                    ))}
                  </p>
                )}
              </div>
            </section>
          );
        })}
      </div>
    </div>
  </div>

  <!-- =====================================================================
       HOW WE WORK
  ====================================================================== -->
  <section class="relative py-20 lg:py-28" aria-labelledby="process-heading">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="max-w-2xl">
        <p class="reveal eyebrow">How we work</p>
        <h2 id="process-heading" class="reveal mt-5 text-[clamp(1.95rem,3.8vw,3.1rem)] leading-[1.07]" style="--i:1">
          Five stages, and none of them optional.
        </h2>
        <p class="reveal mt-5 text-lg leading-relaxed text-ink-soft" style="--i:2">
          We can join at any point in the sequence. Open a stage for the reasoning.
        </p>
      </div>

      <ol class="mt-14 grid items-start gap-5 md:grid-cols-3 lg:grid-cols-5">
        {process.map((p, i) => (
          <li class="reveal group relative" style={`--i:${i}`}>
            {/* Connector line to the next step, desktop only */}
            {i < process.length - 1 && (
              <span
                class="absolute left-[calc(100%+0.35rem)] top-7 hidden h-px w-4 lg:block"
                style="background: linear-gradient(90deg, var(--color-brand-200), transparent);"
                aria-hidden="true"
              ></span>
            )}

            {/* Step and one-line summary up front; the reasoning opens on click. */}
            <details class="group card h-full overflow-hidden [&[open]]:border-brand-200">
              <summary class="cursor-pointer list-none p-5 [&::-webkit-details-marker]:hidden">
                <div class="flex items-center gap-3">
                  <span
                    class="grid h-9 w-9 shrink-0 place-items-center rounded-full font-display text-xs font-bold text-white transition-transform duration-500 group-hover:scale-110"
                    style="background: linear-gradient(140deg, var(--color-brand), var(--color-lime-600));"
                    aria-hidden="true"
                  >
                    {i + 1}
                  </span>
                  <h3 class="font-display text-base font-bold text-ink">{p.step}</h3>
                  <span
                    class="ml-auto shrink-0 text-brand transition-transform duration-300 group-open:rotate-45"
                    aria-hidden="true"
                  >
                    <svg width="11" height="11" viewBox="0 0 12 12" fill="none">
                      <path d="M6 1v10M1 6h10" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                    </svg>
                  </span>
                </div>
                <p class="mt-3 text-sm font-medium leading-snug text-brand">{p.summary}</p>
              </summary>

              <p class="px-5 pb-5 text-sm leading-relaxed text-ink-soft">{p.detail}</p>
            </details>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- =====================================================================
       INDUSTRIES
  ====================================================================== -->
  <section class="relative py-20 lg:py-28" aria-labelledby="industries-heading">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="max-w-2xl">
        <p class="reveal eyebrow">Industry context</p>
        <h2 id="industries-heading" class="reveal mt-5 text-[clamp(1.95rem,3.8vw,3.1rem)] leading-[1.07]" style="--i:1">
          The same services behave differently by sector.
        </h2>
        <p class="reveal mt-5 text-lg leading-relaxed text-ink-soft" style="--i:2">
          What a hazardous area demands is not what a data hall demands.
        </p>
      </div>

      <div class="mt-14 space-y-5">
        {industries.map((ind, i) => (
          <article
            id={`industry-${ind.slug}`}
            class="reveal card scroll-mt-28 p-7 lg:p-8"
            style={`--i:${i % 2}`}
          >
            <div class="flex flex-wrap items-start justify-between gap-x-8 gap-y-4">
              <div class="min-w-0 flex-1">
                <h3 class="font-display text-2xl font-bold text-ink">{ind.name}</h3>
                <p class="mt-3 max-w-2xl leading-relaxed text-ink-soft">{ind.blurb}</p>
                <p class="mt-4 flex gap-2.5 text-sm font-medium text-brand">
                  <span class="mt-[0.45rem] h-1.5 w-1.5 shrink-0 rounded-full bg-lime" aria-hidden="true"></span>
                  {ind.highlight}
                </p>
              </div>
            </div>

            {/* Services this industry leans on */}
            <div class="mt-6">
              <h4 class="font-display text-[0.7rem] font-bold uppercase tracking-[0.13em] text-ink-muted">
                Services most used here
              </h4>
              <ul class="mt-3 flex flex-wrap gap-2">
                {(industryServices[ind.slug] ?? []).map((slug) => {
                  const svc = getService(slug);
                  return (
                    <li>
                      <a
                        href={`#service-${svc.slug}`}
                        class="inline-flex items-center gap-1.5 rounded-full border border-line bg-white/70 px-3.5 py-1.5 text-[0.8rem] font-medium text-ink-soft transition-all duration-300 hover:-translate-y-0.5 hover:border-brand-200 hover:text-brand"
                      >
                        <span aria-hidden="true" class="text-lime-600">&uarr;</span>
                        {svc.title}
                      </a>
                    </li>
                  );
                })}
              </ul>
            </div>

            <div class="expando" id={`ind-scope-${ind.slug}`} data-open="false">
              <div>
                <div class="mt-6 rounded-xl bg-brand-50/70 p-6">
                  <h4 class="font-display text-[0.72rem] font-bold uppercase tracking-[0.13em] text-brand">
                    What we deliver in {ind.name}
                  </h4>
                  <p class="mt-3 text-[0.9rem] leading-[1.75] text-ink-soft">{ind.detail}</p>
                </div>
              </div>
            </div>

            <button
              type="button"
              data-expands={`ind-scope-${ind.slug}`}
              data-label-closed="Full sector scope"
              data-label-open="Show less"
              aria-expanded="false"
              class="mt-6 inline-flex items-center gap-1.5 rounded-lg border border-line px-4 py-2.5 text-xs font-semibold text-brand transition-all duration-300 hover:border-brand-200 hover:bg-brand-50"
            >
              <span data-label>Full sector scope</span>
              <svg class="chev" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                <path d="M2.5 4.5 6 8l3.5-3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- =====================================================================
       TOOLING
  ====================================================================== -->
  <section class="relative py-8 lg:py-12" aria-labelledby="tools-heading">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <h2 id="tools-heading" class="reveal text-center font-display text-sm font-bold uppercase tracking-[0.14em] text-ink-muted">
        Modelled and documented in
      </h2>
    </div>
    <div class="marquee mt-8 overflow-hidden py-2">
      <div class="marquee-track gap-3">
        {[...tools, ...tools].map((t, i) => (
          <span
            aria-hidden={i >= tools.length ? 'true' : undefined}
            class="whitespace-nowrap rounded-full border border-line bg-white/70 px-5 py-2.5 text-sm font-medium text-ink-soft"
          >
            {t}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- =====================================================================
       FAQ
  ====================================================================== -->
  <section class="relative py-20 lg:py-28" aria-labelledby="faq-heading">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-4">
          <p class="reveal eyebrow">Service questions</p>
          <h2 id="faq-heading" class="reveal mt-5 text-[clamp(1.95rem,3.8vw,3.1rem)] leading-[1.07]" style="--i:1">
            Before you enquire.
          </h2>
          <p class="reveal mt-5 text-sm leading-relaxed text-ink-soft" style="--i:2">
            More technical background sits in the
            <a href={withBase('/knowledge-centre')} class="font-semibold text-brand underline underline-offset-4 hover:text-lime-600">
              Knowledge Centre</a>.
          </p>
        </div>

        <div class="lg:col-span-8">
          <dl class="space-y-3">
            {serviceFaqs.map((f, i) => (
              <div class="reveal" style={`--i:${i % 3}`}>
                <details class="card group overflow-hidden [&[open]]:border-brand-200">
                  <summary class="flex cursor-pointer list-none items-center justify-between gap-6 p-6 text-left [&::-webkit-details-marker]:hidden">
                    <dt class="font-display text-base font-bold text-ink transition-colors group-hover:text-brand">
                      {f.q}
                    </dt>
                    <span
                      class="grid h-8 w-8 shrink-0 place-items-center rounded-full border border-line text-brand transition-all duration-300 group-open:rotate-45 group-open:border-brand-200 group-open:bg-brand-50"
                      aria-hidden="true"
                    >
                      <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                        <path d="M6 1v10M1 6h10" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                      </svg>
                    </span>
                  </summary>
                  <dd class="px-6 pb-6 text-[0.95rem] leading-relaxed text-ink-soft">{f.a}</dd>
                </details>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </div>
  </section>

  <!-- =====================================================================
       CTA
  ====================================================================== -->
  <section class="relative pb-24 lg:pb-32">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div
        class="reveal relative isolate overflow-hidden rounded-[28px] px-6 py-16 text-center lg:px-16 lg:py-20"
        style="background: linear-gradient(135deg, #14357B 0%, #1A4194 45%, #2B57B0 100%);"
      >
        <div
          class="pointer-events-none absolute -right-24 -top-24 h-[28rem] w-[28rem] rounded-full opacity-45 blur-3xl"
          style="background: radial-gradient(circle, rgba(176,208,56,0.75) 0%, transparent 65%);"
          aria-hidden="true"
        >
        </div>

        <h2 class="relative mx-auto max-w-3xl text-[clamp(1.9rem,4vw,3.1rem)] leading-[1.06] text-white">
          Tell us the problem, not the service.
        </h2>
        <p class="relative mx-auto mt-5 max-w-xl leading-relaxed text-brand-100">
          Describe what you are trying to achieve and we will tell you what it
          actually needs — including when the answer is less than you expected.
        </p>

        <div class="relative mt-9 flex flex-wrap justify-center gap-3">
          <a
            href={withBase('/contact')}
            class="rounded-xl bg-lime px-7 py-4 font-semibold text-brand-900 transition-all duration-300 hover:-translate-y-0.5 hover:bg-lime-300"
          >
            Start a conversation
          </a>
          <a
            href={`tel:${site.phoneRaw}`}
            class="rounded-xl border border-white/30 px-7 py-4 font-semibold text-white transition-all duration-300 hover:-translate-y-0.5 hover:border-white/60 hover:bg-white/10"
          >
            {site.phone}
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .rail-link.is-current {
    border-left-color: var(--color-brand);
    background: var(--color-brand-50);
    color: var(--color-brand);
    font-weight: 600;
  }
</style>

<script>
  // Scroll-spy for the sticky rail. Tracks which service section occupies the
  // upper band of the viewport and marks the matching rail link.
  const sections = [...document.querySelectorAll<HTMLElement>('[data-service-section]')];
  const links = new Map<string, HTMLElement>();

  document.querySelectorAll<HTMLElement>('[data-rail-link]').forEach((el) => {
    links.set(el.dataset.railLink!, el);
  });

  if (sections.length && links.size && 'IntersectionObserver' in window) {
    const visible = new Set<string>();

    const setCurrent = () => {
      // Topmost visible section wins, so the rail never flickers between two.
      const current = sections.find((s) => visible.has(s.id))?.id;
      links.forEach((el, id) => el.classList.toggle('is-current', id === current));
    };

    const spy = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) visible.add(entry.target.id);
          else visible.delete(entry.target.id);
        }
        setCurrent();
      },
      // Upper band of the viewport, below the fixed header.
      { rootMargin: '-20% 0px -55% 0px', threshold: 0 }
    );

    sections.forEach((s) => spy.observe(s));
  }
</script>
