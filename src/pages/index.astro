---
import { withBase } from '../lib/url';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHead from '../components/SectionHead.astro';
import { site } from '../data/site';
import { services, industries, projects, insights, tools, faqs } from '../data/content';

import imgSolar from '../assets/images/solar-team-900x600.jpg';
import imgMining from '../assets/images/loader-900x600.jpg';
import imgOil from '../assets/images/oil-refinery-900x600.jpg';
import imgPower from '../assets/images/power-line-900x600.jpg';
import imgStudy from '../assets/images/engineering-study.jpg';

const industryImages = {
  'oil-and-gas': imgOil,
  'renewable-energy': imgSolar,
  mining: imgMining,
  utilities: imgPower,
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const servicesSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Electrical engineering services',
  itemListElement: services.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Service',
      name: s.title,
      description: s.summary,
      url: `${site.url}/services/${s.slug}`,
      provider: { '@id': `${site.url}/#organization` },
      areaServed: site.areaServed,
    },
  })),
};
---

<BaseLayout
  title="Electrical Engineering Consultants Calgary | PowSys Engineering"
  description="PowSys Engineering is a woman-owned electrical engineering firm in Calgary, Alberta. Power system studies, arc flash analysis, compliance verification, project management and condition-based maintenance for oil and gas, mining, renewable energy and data centres."
  schema={[faqSchema, servicesSchema]}
>
  <Hero />

  <!-- =====================================================================
       WHO WE ARE
  ====================================================================== -->
  <section class="relative py-20 lg:py-28" aria-labelledby="who-heading">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-5">
          <p class="reveal eyebrow">Who we are</p>
          <h2 id="who-heading" class="reveal mt-5 text-[clamp(1.95rem,3.8vw,3.1rem)] leading-[1.07]" style="--i:1">
            An engineering partner, not just a vendor.
          </h2>
        </div>

        <div class="lg:col-span-7">
          <p class="reveal text-xl leading-relaxed text-ink lg:text-[1.3rem]">
            {site.definition}
          </p>
          <p class="reveal mt-6 leading-relaxed text-ink-soft" style="--i:1">
            We design and deliver fit-for-purpose engineering that meets your business
            requirements for performance, compliance and cost — covering design,
            development, integration, risk management, project planning and control.
            Delivered offsite, onsite, or as a blend of both.
          </p>

          <dl class="mt-12 grid grid-cols-2 gap-x-6 gap-y-8 sm:grid-cols-4">
            {/* `count: false` opts a figure out of the tick-up animation — a
                year counting from zero reads as a glitch, not a flourish. */}
            {[
              { n: 2017, s: '', l: 'Established', count: false },
              { n: 3, s: '', l: 'Provincial permits', count: true },
              { n: 6, s: '+', l: 'Industries served', count: true },
              { n: 15, s: '+', l: 'Engineering tools', count: true },
            ].map((stat, i) => (
              <div class="reveal relative pl-4" style={`--i:${i}`}>
                <span
                  class="absolute left-0 top-1 h-[calc(100%-0.5rem)] w-[3px] rounded-full"
                  style="background: linear-gradient(180deg, var(--color-brand), var(--color-lime));"
                  aria-hidden="true"
                ></span>
                <dt class="sr-only">{stat.l}</dt>
                <dd>
                  <span
                    class="block font-display text-3xl font-bold text-brand lg:text-4xl"
                    data-count-to={stat.count ? stat.n : undefined}
                    data-count-suffix={stat.count ? stat.s : undefined}
                  >
                    {stat.n}{stat.s}
                  </span>
                  <span class="mt-1 block text-sm text-ink-muted">{stat.l}</span>
                </dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </div>
  </section>

  <!-- =====================================================================
       SERVICES — each card expands in place
  ====================================================================== -->
  <section id="services" class="relative py-20 lg:py-28" aria-labelledby="services-heading">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <SectionHead
        id="services-heading"
        eyebrow="What we do"
        title="Six capabilities, one accountable team."
        lead="Open any capability to see its full scope of work."
        linkHref="/services"
        linkLabel="All services"
      />

      <ul class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {services.map((s, i) => (
          <li class="reveal" style={`--i:${i % 3}`}>
            <article class="card group flex h-full flex-col p-7">
              <h3 class="font-display text-xl font-bold">
                <a href={withBase(`/services/${s.slug}`)} class="link-draw relative text-ink transition-colors group-hover:text-brand">
                  {s.title}
                </a>
              </h3>

              <p
                class="mt-2 font-display text-[0.78rem] font-bold uppercase tracking-[0.12em] text-lime-deep"
              >
                {s.threeWords}
              </p>

              <p class="mt-4 text-sm leading-relaxed text-ink-soft">{s.summary}</p>

              <ul class="mt-6 space-y-2.5">
                {s.points.slice(0, 3).map((p) => (
                  <li class="flex gap-2.5 text-sm text-ink-soft">
                    <span
                      class="mt-[0.45rem] h-1.5 w-1.5 shrink-0 rounded-full bg-lime"
                      aria-hidden="true"
                    ></span>
                    <span>{p}</span>
                  </li>
                ))}
              </ul>

              {/* Expandable full scope */}
              <div class="expando mt-1" id={`svc-${s.slug}`} data-open="false">
                <div>
                  <ul class="space-y-2.5 pt-2.5">
                    {s.points.slice(3).map((p) => (
                      <li class="flex gap-2.5 text-sm text-ink-soft">
                        <span
                          class="mt-[0.45rem] h-1.5 w-1.5 shrink-0 rounded-full bg-lime"
                          aria-hidden="true"
                        ></span>
                        <span>{p}</span>
                      </li>
                    ))}
                  </ul>

                  <div class="mt-5 rounded-xl bg-brand-50/70 p-4">
                    <p class="font-display text-[0.72rem] font-bold uppercase tracking-[0.13em] text-brand">
                      {s.detailLabel}
                    </p>
                    <p class="mt-2 text-[0.82rem] leading-relaxed text-ink-soft">{s.detail}</p>
                  </div>
                </div>
              </div>

              <button
                type="button"
                data-expands={`svc-${s.slug}`}
                data-label-closed="Full scope"
                data-label-open="Show less"
                aria-expanded="false"
                class="mt-6 inline-flex items-center gap-1.5 self-start rounded-lg border border-line px-3.5 py-2 text-xs font-semibold text-brand transition-all duration-300 hover:border-brand-200 hover:bg-brand-50"
              >
                <span data-label>Full scope</span>
                <svg class="chev" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <path d="M2.5 4.5 6 8l3.5-3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
            </article>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- =====================================================================
       INDUSTRIES — expandable service lists
  ====================================================================== -->
  <section id="industries" class="relative py-20 lg:py-28" aria-labelledby="industries-heading">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <SectionHead
        id="industries-heading"
        eyebrow="Industry focus"
        title="Environments where getting it wrong is expensive."
        lead="Open an industry to see everything we deliver in it."
        linkHref="/industries"
        linkLabel="All industries"
      />

      <div class="mt-14 grid gap-5 lg:grid-cols-2">
        {industries.map((ind, i) => (
          <article class="reveal card group overflow-hidden" style={`--i:${i % 2}`}>
            <div class="relative h-52 overflow-hidden">
              <Image
                src={industryImages[ind.slug as keyof typeof industryImages]}
                alt={ind.alt}
                widths={[400, 700, 900]}
                sizes="(min-width: 1024px) 45vw, 92vw"
                loading="lazy"
                class="h-full w-full object-cover transition-transform duration-[900ms] ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.06]"
              />
              <div
                class="absolute inset-0"
                style="background: linear-gradient(180deg, rgba(12,32,80,0.10) 0%, rgba(12,32,80,0.55) 100%);"
                aria-hidden="true"
              >
              </div>
              <h3 class="absolute bottom-4 left-6 font-display text-2xl font-bold text-white drop-shadow">
                <a href={withBase(`/industries/${ind.slug}`)}>{ind.name}</a>
              </h3>
            </div>

            <div class="p-7">
              <p class="text-sm leading-relaxed text-ink-soft">{ind.blurb}</p>

              <p class="mt-4 flex gap-2.5 text-sm font-medium text-brand">
                <span class="mt-[0.45rem] h-1.5 w-1.5 shrink-0 rounded-full bg-lime" aria-hidden="true"></span>
                {ind.highlight}
              </p>

              <div class="expando" id={`ind-${ind.slug}`} data-open="false">
                <div>
                  <div class="mt-5 rounded-xl bg-brand-50/70 p-5">
                    <p class="font-display text-[0.72rem] font-bold uppercase tracking-[0.13em] text-brand">
                      What we deliver
                    </p>
                    <p class="mt-2 text-[0.85rem] leading-relaxed text-ink-soft">{ind.detail}</p>
                  </div>
                </div>
              </div>

              <button
                type="button"
                data-expands={`ind-${ind.slug}`}
                data-label-closed="See our full scope"
                data-label-open="Show less"
                aria-expanded="false"
                class="mt-6 inline-flex items-center gap-1.5 rounded-lg border border-line px-3.5 py-2 text-xs font-semibold text-brand transition-all duration-300 hover:border-brand-200 hover:bg-brand-50"
              >
                <span data-label>See our full scope</span>
                <svg class="chev" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <path d="M2.5 4.5 6 8l3.5-3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- =====================================================================
       PROJECTS — expandable rows
  ====================================================================== -->
  <section id="projects" class="relative py-20 lg:py-28" aria-labelledby="projects-heading">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <SectionHead
        id="projects-heading"
        eyebrow="Past projects"
        title="Selected work."
        lead="Illustrative case studies. Open one for scope and tooling."
        linkHref="/projects"
        linkLabel="All projects"
      />

      <ol class="mt-14 space-y-4">
        {projects.map((p, i) => (
          <li class="reveal" style={`--i:${i}`}>
            <article class="card p-7">
              <div class="flex flex-wrap items-start justify-between gap-x-8 gap-y-3">
                <div class="min-w-0 flex-1">
                  <p class="font-display text-[0.72rem] font-bold uppercase tracking-[0.14em] text-lime-deep">
                    {p.category}
                  </p>
                  <h3 class="mt-2 font-display text-xl font-bold text-ink">{p.title}</h3>
                  <p class="mt-2 max-w-2xl text-sm leading-relaxed text-ink-soft">{p.detail}</p>
                </div>

                <p class="flex items-center gap-2 text-sm text-ink-muted">
                  <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true" class="text-brand">
                    <path d="M8 14.5s5-4.2 5-8a5 5 0 0 0-10 0c0 3.8 5 8 5 8Z" stroke="currentColor" stroke-width="1.4" />
                    <circle cx="8" cy="6.5" r="1.8" stroke="currentColor" stroke-width="1.4" />
                  </svg>
                  {p.location}
                </p>
              </div>

              <div class="expando" id={`proj-${i}`} data-open="false">
                <div>
                  <div class="mt-6 grid gap-6 border-t border-line-soft pt-6 sm:grid-cols-3">
                    <div class="sm:col-span-2">
                      <p class="font-display text-[0.72rem] font-bold uppercase tracking-[0.13em] text-brand">
                        Scope of work
                      </p>
                      <ul class="mt-3 space-y-2">
                        {p.scope.map((item) => (
                          <li class="flex gap-2.5 text-sm text-ink-soft">
                            <span class="mt-[0.45rem] h-1.5 w-1.5 shrink-0 rounded-full bg-lime" aria-hidden="true"></span>
                            <span>{item}</span>
                          </li>
                        ))}
                      </ul>
                    </div>
                    <div>
                      <p class="font-display text-[0.72rem] font-bold uppercase tracking-[0.13em] text-brand">
                        Tools
                      </p>
                      <ul class="mt-3 flex flex-wrap gap-2">
                        {p.tools.map((t) => (
                          <li class="rounded-full border border-line bg-white px-3 py-1 text-xs font-medium text-ink-soft">
                            {t}
                          </li>
                        ))}
                      </ul>
                    </div>
                  </div>
                </div>
              </div>

              <button
                type="button"
                data-expands={`proj-${i}`}
                data-label-closed="Project detail"
                data-label-open="Show less"
                aria-expanded="false"
                class="mt-6 inline-flex items-center gap-1.5 rounded-lg border border-line px-3.5 py-2 text-xs font-semibold text-brand transition-all duration-300 hover:border-brand-200 hover:bg-brand-50"
              >
                <span data-label>Project detail</span>
                <svg class="chev" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <path d="M2.5 4.5 6 8l3.5-3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
            </article>
          </li>
        ))}
      </ol>

      <p class="reveal mt-6 text-sm text-ink-muted">
        Limited case studies shown for illustration. Contact us for detailed
        experience, capability statements and references.
      </p>
    </div>
  </section>

  <!-- =====================================================================
       CAPABILITY — tools marquee
  ====================================================================== -->
  <section class="relative py-20 lg:py-28" aria-labelledby="tools-heading">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="grid items-center gap-14 lg:grid-cols-2 lg:gap-16">
        <div class="reveal">
          <p class="eyebrow">Capability</p>
          <h2 id="tools-heading" class="mt-5 text-[clamp(1.95rem,3.8vw,3.1rem)] leading-[1.07]">
            Industry-standard tools, in experienced hands.
          </h2>
          <p class="mt-6 leading-relaxed text-ink-soft">
            Our professionals hold live experience across the technologies, processes,
            compliance frameworks and tools that industrial power systems depend on —
            from ETAP and SKM modelling through to hazardous-area verification dossiers.
          </p>

          <a
            href={withBase('/about')}
            class="group mt-8 inline-flex items-center gap-2 text-sm font-semibold text-brand transition-colors hover:text-lime-deep"
          >
            <span class="link-draw relative">About our team</span>
            <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
          </a>
        </div>

        <div class="reveal relative" style="--i:1">
          <div
            class="absolute -inset-3 -z-10 rounded-[28px] opacity-50 blur-2xl"
            style="background: linear-gradient(140deg, rgba(176,208,56,0.32), rgba(26,65,148,0.24));"
            aria-hidden="true"
          >
          </div>
          <Image
            src={imgStudy}
            alt="Two engineers reviewing a technical site drawing together"
            widths={[500, 800, 1100]}
            sizes="(min-width: 1024px) 45vw, 92vw"
            loading="lazy"
            class="aspect-[5/4] w-full rounded-[22px] object-cover shadow-[0_30px_60px_-32px_rgba(14,27,51,0.5)] ring-1 ring-brand-900/10"
          />
        </div>
      </div>
    </div>

    {/* Full-bleed marquee of tooling */}
    <div class="marquee mt-16 overflow-hidden py-2" aria-label="Engineering software we use">
      <div class="marquee-track gap-3">
        {[...tools, ...tools].map((t, i) => (
          <span
            aria-hidden={i >= tools.length ? 'true' : undefined}
            class="whitespace-nowrap rounded-full border border-line bg-white/70 px-5 py-2.5 text-sm font-medium text-ink-soft"
          >
            {t}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- =====================================================================
       INSIGHTS / BLOG
  ====================================================================== -->
  <section id="insights" class="relative py-20 lg:py-28" aria-labelledby="insights-heading">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <SectionHead
        id="insights-heading"
        eyebrow="Insights"
        title="Engineering, explained."
        lead="Technical writing on the standards, tests and studies our clients ask about most."
        linkHref="/insights"
        linkLabel="All articles"
      />

      <ul class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {insights.map((post, i) => (
          <li class="reveal" style={`--i:${i}`}>
            <article class="card group flex h-full flex-col p-6">
              <div class="flex items-center justify-between gap-3">
                <span class="rounded-full bg-lime-50 px-3 py-1 text-[0.7rem] font-bold uppercase tracking-wider text-lime-deep">
                  {post.category}
                </span>
                {post.status === 'planned' && (
                  <span class="text-[0.68rem] font-semibold uppercase tracking-wider text-ink-muted">
                    Coming soon
                  </span>
                )}
              </div>

              <h3 class="mt-4 font-display text-base font-bold leading-snug text-ink transition-colors group-hover:text-brand">
                {post.title}
              </h3>

              <p class="mt-3 flex-1 text-sm leading-relaxed text-ink-soft">{post.excerpt}</p>

              <p class="mt-5 border-t border-line-soft pt-4 text-xs text-ink-muted">
                {post.readMinutes} min read
              </p>
            </article>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- =====================================================================
       FAQ
  ====================================================================== -->
  <section class="relative py-20 lg:py-28" aria-labelledby="faq-heading">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-4">
          <p class="reveal eyebrow">Common questions</p>
          <h2 id="faq-heading" class="reveal mt-5 text-[clamp(1.95rem,3.8vw,3.1rem)] leading-[1.07]" style="--i:1">
            Answers, in plain terms.
          </h2>
          <p class="reveal mt-5 text-sm leading-relaxed text-ink-soft" style="--i:2">
            Something not covered here?
            <a href={withBase('/contact')} class="font-semibold text-brand underline underline-offset-4 hover:text-lime-deep">
              Ask our team directly.
            </a>
          </p>
        </div>

        <div class="lg:col-span-8">
          <div class="space-y-3">
            {faqs.map((f, i) => (
              <div class="reveal" style={`--i:${i % 3}`}>
                <details class="card group overflow-hidden [&[open]]:border-brand-200">
                  <summary
                    class="flex cursor-pointer list-none items-center justify-between gap-6 p-6 text-left [&::-webkit-details-marker]:hidden"
                  >
                    <h3 class="font-display text-base font-bold text-ink transition-colors group-hover:text-brand">
                      {f.q}
                    </h3>
                    <span
                      class="grid h-8 w-8 shrink-0 place-items-center rounded-full border border-line text-brand transition-all duration-300 group-open:rotate-45 group-open:border-brand-200 group-open:bg-brand-50"
                      aria-hidden="true"
                    >
                      <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                        <path d="M6 1v10M1 6h10" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
                      </svg>
                    </span>
                  </summary>
                  <p class="px-6 pb-6 text-[0.95rem] leading-relaxed text-ink-soft">{f.a}</p>
                </details>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =====================================================================
       CTA
  ====================================================================== -->
  <section class="relative py-20 lg:py-28">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div
        class="reveal relative isolate overflow-hidden rounded-[28px] px-6 py-16 text-center lg:px-16 lg:py-20"
        style="background: linear-gradient(135deg, #14357B 0%, #1A4194 45%, #2B57B0 100%);"
      >
        <div
          class="pointer-events-none absolute -right-24 -top-24 h-[28rem] w-[28rem] rounded-full opacity-45"
          style="background: radial-gradient(circle, rgba(176,208,56,0.75) 0%, transparent 65%);"
          aria-hidden="true"
        >
        </div>

        <h2 class="relative mx-auto max-w-3xl text-[clamp(1.9rem,4vw,3.1rem)] leading-[1.06] text-white">
          Have a project you would like to discuss?
        </h2>
        <p class="relative mx-auto mt-5 max-w-xl leading-relaxed text-brand-100">
          Send us an RFI, an RFP, or just a question. We respond to enquiries
          within two working days.
        </p>

        <div class="relative mt-9 flex flex-wrap justify-center gap-3">
          <a
            href={withBase('/contact')}
            class="rounded-xl bg-lime px-7 py-4 font-semibold text-brand-900 transition-all duration-300 hover:-translate-y-0.5 hover:bg-lime-300"
          >
            Contact our team
          </a>
          <a
            href={`tel:${site.phoneRaw}`}
            class="rounded-xl border border-white/30 px-7 py-4 font-semibold text-white transition-all duration-300 hover:-translate-y-0.5 hover:border-white/60 hover:bg-white/10"
          >
            {site.phone}
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
