---
import { withBase } from '../../lib/url';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteForm from '../../components/SiteForm.astro';
import MapEmbed from '../../components/MapEmbed.astro';
import { site } from '../../data/site';
import { services } from '../../data/content';
import { officeHours } from '../../data/team';
import { FORM_ENDPOINTS } from '../../data/forms';

const contactSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  '@id': `${site.url}/contact#page`,
  url: `${site.url}/contact`,
  name: `Contact ${site.legalName}`,
  description: `Contact PowSys Engineering in Calgary, Alberta — enquiries, requests for information and requests for proposal.`,
  mainEntity: { '@id': `${site.url}/#organization` },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
    { '@type': 'ListItem', position: 2, name: 'Contact', item: `${site.url}/contact` },
  ],
};

const channels = [
  {
    label: 'Email',
    value: site.email,
    href: `mailto:${site.email}`,
    note: 'General enquiries, RFIs and RFPs',
    icon: 'mail',
  },
  {
    label: 'Phone',
    value: site.phone,
    href: `tel:${site.phoneRaw}`,
    note: 'Toll free, Mountain Time',
    icon: 'phone',
  },
  {
    label: 'SMS',
    value: site.phone,
    href: `sms:${site.phoneRaw}`,
    note: 'Text us if it is quicker',
    icon: 'chat',
  },
  {
    label: 'Careers',
    value: site.hrEmail,
    href: `mailto:${site.hrEmail}`,
    note: 'Applications and expressions of interest',
    icon: 'mail',
  },
];
---

<BaseLayout
  title="Contact PowSys Engineering | Calgary, Alberta"
  description="Contact PowSys Engineering in Calgary, Alberta. Send an enquiry, RFI or RFP, call +1 (866) 269-0545, or book a meeting. We respond to enquiries within two working days."
  schema={[contactSchema, breadcrumbSchema]}
>
  <!-- =====================================================================
       HERO
  ====================================================================== -->
  <section class="relative isolate overflow-hidden pt-32 pb-12 lg:pt-40 lg:pb-14">
    <div
      class="pointer-events-none absolute -top-40 right-[-8%] -z-10 h-[44rem] w-[44rem] rounded-full opacity-70 blur-3xl"
      style="background: radial-gradient(circle, rgba(176,208,56,0.30) 0%, rgba(176,208,56,0.06) 45%, transparent 70%);"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute -left-[12%] top-24 -z-10 h-[36rem] w-[36rem] rounded-full opacity-70 blur-3xl"
      style="background: radial-gradient(circle, rgba(26,65,148,0.20) 0%, rgba(26,65,148,0.04) 48%, transparent 70%);"
      aria-hidden="true"
    >
    </div>

    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <nav aria-label="Breadcrumb" class="reveal">
        <ol class="flex items-center gap-2 text-xs text-ink-muted">
          <li><a href={withBase('/')} class="transition-colors hover:text-brand">Home</a></li>
          <li aria-hidden="true">/</li>
          <li class="font-medium text-ink-soft">Contact</li>
        </ol>
      </nav>

      <p class="reveal eyebrow mt-6" style="--i:1">Contact</p>

      <h1 class="reveal mt-5 max-w-4xl text-[clamp(2.2rem,5vw,4rem)] leading-[1.05]" style="--i:2">
        Tell us the problem, <span class="grad-text">not the service</span>.
      </h1>

      <p class="reveal mt-6 max-w-2xl text-lg leading-relaxed text-ink-soft" style="--i:3">
        Requests for information, requests for proposal, or a question you have
        not been able to get a straight answer to. We respond within two working
        days.
      </p>
    </div>
  </section>

  <!-- =====================================================================
       CHANNELS
  ====================================================================== -->
  <section class="relative py-8 lg:py-12" aria-labelledby="channels-heading">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <h2 id="channels-heading" class="sr-only">Ways to reach us</h2>

      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {channels.map((c, i) => (
          <li class="reveal" style={`--i:${i}`}>
            <a href={withBase(c.href)} class="card group flex h-full flex-col p-6">
              <span
                class="grid h-10 w-10 place-items-center rounded-lg bg-brand-50 text-brand transition-colors duration-300 group-hover:bg-brand group-hover:text-white"
                aria-hidden="true"
              >
                {c.icon === 'mail' && (
                  <svg width="18" height="18" viewBox="0 0 16 16" fill="none">
                    <rect x="2" y="3.5" width="12" height="9" rx="1.6" stroke="currentColor" stroke-width="1.3" />
                    <path d="m2.6 4.6 5.4 4 5.4-4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
                  </svg>
                )}
                {c.icon === 'phone' && (
                  <svg width="18" height="18" viewBox="0 0 16 16" fill="none">
                    <path d="M5.2 2.6 6.6 5.4 5.3 6.7a7 7 0 0 0 4 4l1.3-1.3 2.8 1.4v2.1c0 .5-.4.9-.9.8A11.4 11.4 0 0 1 2.3 3.5c0-.5.3-.9.8-.9h2.1Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" />
                  </svg>
                )}
                {c.icon === 'chat' && (
                  <svg width="18" height="18" viewBox="0 0 16 16" fill="none">
                    <path d="M3.5 3h9a1.5 1.5 0 0 1 1.5 1.5v5A1.5 1.5 0 0 1 12.5 11H7l-3 2.4V11h-.5A1.5 1.5 0 0 1 2 9.5v-5A1.5 1.5 0 0 1 3.5 3Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" />
                  </svg>
                )}
              </span>

              <p class="mt-5 font-display text-[0.7rem] font-bold uppercase tracking-[0.13em] text-ink-muted">
                {c.label}
              </p>
              <p class="mt-1.5 break-words text-sm font-semibold text-brand transition-colors group-hover:text-lime-600">
                {c.value}
              </p>
              <p class="mt-2 flex-1 text-xs leading-relaxed text-ink-muted">{c.note}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- =====================================================================
       FORM + DETAILS
  ====================================================================== -->
  <section class="relative py-12 lg:py-16" aria-labelledby="form-heading">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
        <div class="lg:col-span-7">
          <h2 id="form-heading" class="reveal text-[clamp(1.8rem,3.4vw,2.7rem)] leading-[1.08]">
            Send us the details.
          </h2>
          <p class="reveal mt-4 leading-relaxed text-ink-soft" style="--i:1">
            The more you can tell us about sector, scope and timeline, the more
            useful our first reply will be.
          </p>

          <div class="reveal card mt-8 p-7 lg:p-8" style="--i:2">
            <SiteForm
              id="contact-form"
              endpoint={FORM_ENDPOINTS.contact}
              subject="Website enquiry — powsysengineering.com"
              submitLabel="Send enquiry"
              note="We reply within two working days."
              fields={[
                { name: 'name', label: 'Full name', required: true },
                { name: 'company', label: 'Company' },
                { name: 'email', label: 'Email', type: 'email', required: true },
                { name: 'phone', label: 'Phone', type: 'tel' },
                {
                  name: 'enquiry',
                  label: 'Type of enquiry',
                  type: 'select',
                  required: true,
                  options: [
                    'General enquiry',
                    'Request for information (RFI)',
                    'Request for proposal (RFP)',
                    'Brochure / capability statement',
                    'Feedback or complaint',
                  ],
                },
                {
                  name: 'service',
                  label: 'Service of interest',
                  type: 'select',
                  options: ['Not sure yet', ...services.map((s) => s.title)],
                },
                {
                  name: 'message',
                  label: 'How can we help?',
                  type: 'textarea',
                  required: true,
                  placeholder: 'Sector, scope, timeline, and anything already decided.',
                },
              ]}
            />
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="reveal card p-7">
            <h3 class="font-display text-[0.72rem] font-bold uppercase tracking-[0.13em] text-brand">
              Office
            </h3>
            <address class="mt-4 text-sm not-italic leading-relaxed text-ink-soft">
              <span class="font-semibold text-ink">{site.legalName}</span><br />
              {site.address.street}<br />
              {site.address.locality}, {site.address.region} {site.address.postalCode}<br />
              Canada
            </address>
            <p class="mt-3 rounded-lg bg-brand-50/70 px-4 py-3 text-xs leading-relaxed text-ink-soft">
              <strong class="font-semibold text-ink">Visit by appointment only.</strong>
              {' '}Please book before coming.
            </p>

            <a
              href={withBase('/about#book')}
              class="group mt-5 inline-flex items-center gap-2 text-sm font-semibold text-brand transition-colors hover:text-lime-600"
            >
              <span class="link-draw relative">Book a meeting or tour</span>
              <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
            </a>
          </div>

          <div class="reveal card mt-5 p-7" style="--i:1">
            <h3 class="font-display text-[0.72rem] font-bold uppercase tracking-[0.13em] text-brand">
              Office hours
            </h3>
            <dl class="mt-4 divide-y divide-line-soft">
              {officeHours.map((h) => (
                <div class="flex items-center justify-between gap-4 py-2.5">
                  <dt class="text-sm text-ink-soft">{h.day}</dt>
                  <dd class="text-sm font-semibold text-ink">
                    {h.opens ? `${h.opens} – ${h.closes}` : 'Closed'}
                  </dd>
                </div>
              ))}
            </dl>
            <p class="mt-3 text-xs text-ink-muted">Mountain Time (MT)</p>
          </div>

          <div class="reveal card mt-5 p-7" style="--i:2">
            <h3 class="font-display text-[0.72rem] font-bold uppercase tracking-[0.13em] text-brand">
              Follow
            </h3>
            <a
              href={site.social.linkedin}
              rel="noopener"
              class="mt-4 inline-flex items-center gap-2 text-sm font-medium text-ink-soft transition-colors hover:text-brand"
            >
              <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.55V9h3.57v11.45Z" />
              </svg>
              LinkedIn
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =====================================================================
       MAP
  ====================================================================== -->
  <section class="relative pb-24 lg:pb-32" aria-labelledby="map-heading">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <h2 id="map-heading" class="reveal text-[clamp(1.8rem,3.4vw,2.7rem)] leading-[1.08]">
        Find us.
      </h2>
      <div class="reveal mt-8">
        <MapEmbed />
      </div>
    </div>
  </section>
</BaseLayout>
