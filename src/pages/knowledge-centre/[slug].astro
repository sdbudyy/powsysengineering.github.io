---
import { withBase } from '../../lib/url';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntryCard from '../../components/EntryCard.astro';
import { site } from '../../data/site';
import { sortedEntries, typeStyles, formatDate, type Entry } from '../../data/knowledge';

export function getStaticPaths() {
  return sortedEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props { entry: Entry }
const { entry } = Astro.props;

/* Related: same category first, then anything else, capped at three. */
const related = [
  ...sortedEntries.filter((e) => e.slug !== entry.slug && e.category === entry.category),
  ...sortedEntries.filter((e) => e.slug !== entry.slug && e.category !== entry.category),
].slice(0, 3);

const url = `${site.url}/knowledge-centre/${entry.slug}`;

const postSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${url}#post`,
  headline: entry.title,
  description: entry.excerpt,
  url,
  datePublished: entry.date,
  dateModified: entry.date,
  author: { '@type': 'Organization', name: entry.author },
  publisher: { '@id': `${site.url}/#organization` },
  articleSection: entry.category,
  timeRequired: `PT${entry.readMinutes}M`,
  inLanguage: 'en-CA',
  isPartOf: { '@id': `${site.url}/knowledge-centre#blog` },
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
    { '@type': 'ListItem', position: 2, name: 'Knowledge Centre', item: `${site.url}/knowledge-centre` },
    { '@type': 'ListItem', position: 3, name: entry.title, item: url },
  ],
};
---

<BaseLayout
  title={`${entry.seoTitle ?? entry.title} | PowSys Engineering`}
  description={entry.excerpt}
  schema={[postSchema, breadcrumbSchema]}
>
  <article class="relative">
    <!-- =================================================================
         HEAD
    ================================================================== -->
    <header class="relative isolate overflow-hidden pt-32 pb-10 lg:pt-40 lg:pb-12">
      <div
        class="pointer-events-none absolute -top-40 right-[-8%] -z-10 h-[38rem] w-[38rem] rounded-full opacity-60"
        style="background: radial-gradient(circle, rgba(176,208,56,0.26) 0%, transparent 68%);"
        aria-hidden="true"
      >
      </div>

      <div class="mx-auto max-w-3xl px-5 lg:px-8">
        <nav aria-label="Breadcrumb">
          <ol class="flex flex-wrap items-center gap-2 text-xs text-ink-muted">
            <li><a href={withBase('/')} class="transition-colors hover:text-brand">Home</a></li>
            <li aria-hidden="true">/</li>
            <li>
              <a href={withBase('/knowledge-centre')} class="transition-colors hover:text-brand">Knowledge Centre</a>
            </li>
          </ol>
        </nav>

        <div class="mt-7 flex flex-wrap items-center gap-2">
          <span
            class={`rounded-full border px-2.5 py-1 text-[0.68rem] font-bold uppercase tracking-[0.09em] ${typeStyles[entry.type]}`}
          >
            {entry.type}
          </span>
          <span class="rounded-full border border-line bg-white/70 px-2.5 py-1 text-[0.68rem] font-semibold text-ink-soft">
            {entry.category}
          </span>
        </div>

        <h1 class="mt-6 text-[clamp(1.9rem,4.4vw,3.2rem)] leading-[1.08]">
          {entry.title}
        </h1>

        <p class="mt-5 text-lg leading-relaxed text-ink-soft">{entry.excerpt}</p>

        <div class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-2 border-t border-line pt-5 text-sm">
          <span class="inline-flex items-center gap-1.5 font-semibold text-brand">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <circle cx="8" cy="8" r="6.4" stroke="currentColor" stroke-width="1.4" />
              <path d="M8 4.6V8l2.3 1.4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
            </svg>
            {entry.readMinutes} min read
          </span>
          <span class="text-line" aria-hidden="true">|</span>
          <time datetime={entry.date} class="text-ink-muted">{formatDate(entry.date)}</time>
          <span class="text-line" aria-hidden="true">|</span>
          <span class="text-ink-muted">{entry.author}</span>
        </div>
      </div>
    </header>

    <!-- =================================================================
         BODY
    ================================================================== -->
    <div class="mx-auto max-w-3xl px-5 pb-20 lg:px-8 lg:pb-24">
      {entry.body.map((block) => (
        <>
          {block.h && (
            <h2 class="reveal mt-12 font-display text-2xl font-bold">{block.h}</h2>
          )}

          {block.p && (
            <p class="reveal mt-5 text-[1.05rem] leading-[1.75] text-ink-soft">{block.p}</p>
          )}

          {block.ul && (
            <ul class="reveal mt-5 space-y-3">
              {block.ul.map((li) => (
                <li class="flex gap-3 text-[1.02rem] leading-[1.7] text-ink-soft">
                  <span class="mt-[0.6rem] h-1.5 w-1.5 shrink-0 rounded-full bg-lime" aria-hidden="true"></span>
                  <span>{li}</span>
                </li>
              ))}
            </ul>
          )}

          {block.quote && (
            <blockquote
              class="reveal my-9 border-l-[3px] pl-6 font-display text-xl font-semibold leading-snug text-ink"
              style="border-image: linear-gradient(180deg, var(--color-brand), var(--color-lime)) 1;"
            >
              {block.quote}
            </blockquote>
          )}
        </>
      ))}

      {/* Filler notice — remove once real content replaces the draft. */}
      <aside class="mt-14 rounded-xl border border-line bg-paper-tint/70 p-5 text-sm text-ink-muted">
        <strong class="font-semibold text-ink-soft">Placeholder content.</strong>
        This entry is filler written to build out the Knowledge Centre. Replace
        the <code class="rounded bg-white px-1 py-0.5 text-xs">body</code> in
        <code class="rounded bg-white px-1 py-0.5 text-xs">src/data/knowledge.ts</code>
        with the real piece before launch.
      </aside>

      <div class="mt-10 border-t border-line pt-8">
        <a
          href={withBase('/knowledge-centre')}
          class="group inline-flex items-center gap-2 text-sm font-semibold text-brand transition-colors hover:text-lime-deep"
        >
          <span class="transition-transform duration-300 group-hover:-translate-x-1" aria-hidden="true">&larr;</span>
          <span class="link-draw relative">Back to the Knowledge Centre</span>
        </a>
      </div>
    </div>

    <!-- =================================================================
         RELATED
    ================================================================== -->
    <section class="relative pb-24 lg:pb-32" aria-labelledby="related-heading">
      <div class="mx-auto max-w-7xl px-5 lg:px-8">
        <h2 id="related-heading" class="reveal font-display text-2xl font-bold">Keep reading</h2>

        <ul class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {related.map((e, i) => (
            <li class="reveal" style={`--i:${i}`}>
              <EntryCard entry={e} />
            </li>
          ))}
        </ul>
      </div>
    </section>
  </article>
</BaseLayout>
