---
import { withBase } from '../../lib/url';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Avatar from '../../components/Avatar.astro';
import MapEmbed from '../../components/MapEmbed.astro';
import SiteForm from '../../components/SiteForm.astro';
import { site } from '../../data/site';
import { credentials, tools } from '../../data/content';
import { team, officeHours, hoursVerified, values } from '../../data/team';
import { FORM_ENDPOINTS } from '../../data/forms';

const aboutSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  '@id': `${site.url}/about#about`,
  url: `${site.url}/about`,
  name: `About ${site.legalName}`,
  description: site.definition,
  mainEntity: { '@id': `${site.url}/#organization` },
};

/* Employees are published as their own entities so the people are indexable,
   not just the company. */
const peopleSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'PowSys Engineering team',
  itemListElement: team.map((m, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Person',
      name: m.name,
      jobTitle: m.role,
      url: `${site.url}/about/${m.slug}`,
      worksFor: { '@id': `${site.url}/#organization` },
      knowsAbout: m.focus,
    },
  })),
};

/* Opening hours are only published as structured data once someone has
   confirmed them — see the note in team.ts. */
const hoursSchema = hoursVerified
  ? {
      '@context': 'https://schema.org',
      '@type': 'LocalBusiness',
      '@id': `${site.url}/#organization`,
      openingHoursSpecification: officeHours
        .filter((h) => h.opens)
        .map((h) => ({
          '@type': 'OpeningHoursSpecification',
          dayOfWeek: h.day,
          opens: h.opens,
          closes: h.closes,
        })),
    }
  : null;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
    { '@type': 'ListItem', position: 2, name: 'About', item: `${site.url}/about` },
  ],
};

const schema = [aboutSchema, peopleSchema, breadcrumbSchema];
if (hoursSchema) schema.push(hoursSchema);
---

<BaseLayout
  title="About PowSys Engineering | Team, Office & Contact"
  description="Meet the PowSys Engineering team, find the Calgary office, book a meeting or a tour, request the company brochure, and subscribe to technical publications from a woman-owned electrical engineering firm founded in 2017."
  schema={schema}
>
  <!-- =====================================================================
       HERO
  ====================================================================== -->
  <section class="relative isolate overflow-hidden pt-32 pb-12 lg:pt-40 lg:pb-16">
    <div
      class="pointer-events-none absolute -top-40 right-[-8%] -z-10 h-[44rem] w-[44rem] rounded-full opacity-70 blur-3xl"
      style="background: radial-gradient(circle, rgba(176,208,56,0.30) 0%, rgba(176,208,56,0.06) 45%, transparent 70%);"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute -left-[12%] top-24 -z-10 h-[36rem] w-[36rem] rounded-full opacity-70 blur-3xl"
      style="background: radial-gradient(circle, rgba(26,65,148,0.20) 0%, rgba(26,65,148,0.04) 48%, transparent 70%);"
      aria-hidden="true"
    >
    </div>

    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <nav aria-label="Breadcrumb" class="reveal">
        <ol class="flex items-center gap-2 text-xs text-ink-muted">
          <li><a href={withBase('/')} class="transition-colors hover:text-brand">Home</a></li>
          <li aria-hidden="true">/</li>
          <li class="font-medium text-ink-soft">About</li>
        </ol>
      </nav>

      <p class="reveal eyebrow mt-6" style="--i:1">Who we are</p>

      <h1 class="reveal mt-5 max-w-4xl text-[clamp(2.2rem,5vw,4rem)] leading-[1.05]" style="--i:2">
        A small team, <span class="grad-text">deliberately</span>.
      </h1>

      <p class="reveal mt-6 max-w-2xl text-lg leading-relaxed text-ink-soft" style="--i:3">
        {site.definition}
      </p>

      <div class="reveal mt-9 flex flex-wrap gap-3" style="--i:4">
        <a
          href={withBase('/about/our-story')}
          class="rounded-xl bg-brand px-7 py-4 font-semibold text-white transition-all duration-300 hover:-translate-y-0.5 hover:bg-brand-700"
        >
          Read our story
        </a>
        <a
          href="#book"
          class="rounded-xl border border-line bg-white/70 px-7 py-4 font-semibold text-ink transition-all duration-300 hover:-translate-y-0.5 hover:border-brand-200"
        >
          Book a meeting
        </a>
      </div>
    </div>
  </section>

  <!-- =====================================================================
       VALUES
  ====================================================================== -->
  <section class="relative py-12 lg:py-16" aria-labelledby="values-heading">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <h2 id="values-heading" class="sr-only">Our values</h2>
      <ul class="grid gap-5 md:grid-cols-3">
        {values.map((v, i) => (
          <li class="reveal card p-7" style={`--i:${i}`}>
            <span class="block h-1 w-10 rounded-full" style="background: linear-gradient(90deg, var(--color-brand), var(--color-lime));" aria-hidden="true"></span>
            <h3 class="mt-5 font-display text-lg font-bold text-ink">{v.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-ink-soft">{v.detail}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- =====================================================================
       TEAM
  ====================================================================== -->
  <section id="team" class="relative scroll-mt-28 py-16 lg:py-20" aria-labelledby="team-heading">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="max-w-2xl">
        <p class="reveal eyebrow">The team</p>
        <h2 id="team-heading" class="reveal mt-5 text-[clamp(1.8rem,3.4vw,2.7rem)] leading-[1.08]" style="--i:1">
          The people you will actually deal with.
        </h2>
      </div>

      <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {team.map((m, i) => (
          <li class="reveal" style={`--i:${i}`}>
            <article class="card group relative flex h-full flex-col items-center p-8 text-center">
              <Avatar member={m} size={112} class="transition-transform duration-500 group-hover:scale-105" />

              <h3 class="mt-5 font-display text-lg font-bold">
                <a href={withBase(`/about/${m.slug}`)} class="text-ink transition-colors after:absolute after:inset-0 group-hover:text-brand">
                  {m.name}{m.credentials ? `, ${m.credentials}` : ''}
                </a>
              </h3>

              <p class="mt-1 font-display text-[0.75rem] font-bold uppercase tracking-[0.11em] text-lime-600">
                {m.role}
              </p>

              <p class="mt-4 flex-1 text-sm leading-relaxed text-ink-soft">{m.summary}</p>

              <span class="mt-5 inline-flex items-center gap-1.5 text-xs font-semibold text-brand">
                Read profile
                <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">&rarr;</span>
              </span>
            </article>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- =====================================================================
       CREDENTIALS
  ====================================================================== -->
  <section class="relative py-12 lg:py-16" aria-labelledby="creds-heading">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="card p-8 lg:p-10">
        <h2 id="creds-heading" class="reveal font-display text-[0.72rem] font-bold uppercase tracking-[0.14em] text-brand">
          Licensed &amp; accredited
        </h2>
        <ul class="reveal mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {credentials.map((c) => (
            <li class="flex gap-3">
              <span class="mt-[0.45rem] h-1.5 w-1.5 shrink-0 rounded-full bg-lime" aria-hidden="true"></span>
              <span>
                <span class="block text-sm font-bold text-ink">{c.abbr}</span>
                <span class="mt-0.5 block text-xs leading-relaxed text-ink-muted">{c.name}</span>
              </span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="marquee mt-12 overflow-hidden py-2" aria-label="Engineering software the team uses">
      <div class="marquee-track gap-3">
        {[...tools, ...tools].map((t, i) => (
          <span
            aria-hidden={i >= tools.length ? 'true' : undefined}
            class="whitespace-nowrap rounded-full border border-line bg-white/70 px-5 py-2.5 text-sm font-medium text-ink-soft"
          >
            {t}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- =====================================================================
       VISIT US — map + hours
  ====================================================================== -->
  <section id="visit" class="relative scroll-mt-28 py-16 lg:py-20" aria-labelledby="visit-heading">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="max-w-2xl">
        <p class="reveal eyebrow">Visit us</p>
        <h2 id="visit-heading" class="reveal mt-5 text-[clamp(1.8rem,3.4vw,2.7rem)] leading-[1.08]" style="--i:1">
          The Calgary office.
        </h2>
        <p class="reveal mt-5 leading-relaxed text-ink-soft" style="--i:2">
          We work by appointment, so let us know you are coming and someone
          relevant will be there.
        </p>
      </div>

      <div class="mt-12 grid gap-6 lg:grid-cols-12 lg:gap-8">
        <div class="reveal lg:col-span-7">
          <MapEmbed />
        </div>

        <div class="lg:col-span-5">
          <div class="reveal card p-7">
            <h3 class="font-display text-[0.72rem] font-bold uppercase tracking-[0.13em] text-brand">
              Office hours
            </h3>
            <dl class="mt-4 divide-y divide-line-soft">
              {officeHours.map((h) => (
                <div class="flex items-center justify-between gap-4 py-2.5">
                  <dt class="text-sm text-ink-soft">{h.day}</dt>
                  <dd class="text-sm font-semibold text-ink">
                    {h.opens ? `${h.opens} – ${h.closes}` : 'Closed'}
                  </dd>
                </div>
              ))}
            </dl>
            <p class="mt-4 rounded-lg bg-brand-50/70 px-4 py-3 text-xs leading-relaxed text-ink-soft">
              <strong class="font-semibold text-ink">By appointment only.</strong>
              Please book before visiting — Mountain Time.
            </p>
          </div>

          <div class="reveal card mt-5 p-7" style="--i:1">
            <h3 class="font-display text-[0.72rem] font-bold uppercase tracking-[0.13em] text-brand">
              Get in touch
            </h3>
            <address class="mt-4 space-y-3 text-sm not-italic text-ink-soft">
              <p>
                <a href={`mailto:${site.email}`} class="font-medium text-brand transition-colors hover:text-lime-600">
                  {site.email}
                </a>
              </p>
              <p>
                <a href={`tel:${site.phoneRaw}`} class="font-medium text-brand transition-colors hover:text-lime-600">
                  {site.phone}
                </a>
              </p>
              <p class="leading-relaxed">
                {site.legalName}<br />
                {site.address.street}<br />
                {site.address.locality}, {site.address.region} {site.address.postalCode}<br />
                Canada
              </p>
            </address>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =====================================================================
       BOOK A MEETING OR TOUR
  ====================================================================== -->
  <section id="book" class="relative scroll-mt-28 py-16 lg:py-20" aria-labelledby="book-heading">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
        <div class="lg:col-span-5">
          <p class="reveal eyebrow">Book</p>
          <h2 id="book-heading" class="reveal mt-5 text-[clamp(1.8rem,3.4vw,2.7rem)] leading-[1.08]" style="--i:1">
            Book a meeting or a tour.
          </h2>
          <p class="reveal mt-5 leading-relaxed text-ink-soft" style="--i:2">
            An introductory call, a technical meeting about a live scope, or a
            walk through the office. Tell us which and when suits, and we will
            confirm.
          </p>

          <ul class="reveal mt-8 space-y-3" style="--i:3">
            {[
              ['Introductory call', '30 minutes, remote — who we are and whether we fit.'],
              ['Technical meeting', 'Bring a live scope. An engineer, not a salesperson.'],
              ['Office tour', 'In person in Calgary, by appointment.'],
            ].map(([title, detail]) => (
              <li class="flex gap-3">
                <span class="mt-[0.45rem] h-1.5 w-1.5 shrink-0 rounded-full bg-lime" aria-hidden="true"></span>
                <span>
                  <span class="block text-sm font-semibold text-ink">{title}</span>
                  <span class="mt-0.5 block text-sm text-ink-soft">{detail}</span>
                </span>
              </li>
            ))}
          </ul>
        </div>

        <div class="lg:col-span-7">
          <div class="reveal card p-7 lg:p-8">
            <SiteForm
              id="booking"
              endpoint={FORM_ENDPOINTS.booking}
              subject="Meeting / tour booking request — powsysengineering.com"
              submitLabel="Request booking"
              note="We confirm within two working days."
              fields={[
                { name: 'name', label: 'Full name', required: true },
                { name: 'company', label: 'Company' },
                { name: 'email', label: 'Email', type: 'email', required: true },
                { name: 'phone', label: 'Phone', type: 'tel' },
                {
                  name: 'type',
                  label: 'What would you like to book?',
                  type: 'select',
                  required: true,
                  options: ['Introductory call', 'Technical meeting', 'Office tour'],
                },
                { name: 'date', label: 'Preferred date', type: 'date' },
                { name: 'time', label: 'Preferred time', type: 'time' },
                {
                  name: 'message',
                  label: 'What would you like to cover?',
                  type: 'textarea',
                  placeholder: 'Sector, scope, and anything we should read beforehand.',
                },
              ]}
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =====================================================================
       BROCHURE
  ====================================================================== -->
  <section id="brochure" class="relative scroll-mt-28 py-16 lg:py-20" aria-labelledby="brochure-heading">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div class="card grid gap-8 p-8 lg:grid-cols-12 lg:items-center lg:gap-12 lg:p-10">
        <div class="reveal lg:col-span-7">
          <p class="eyebrow">Brochure</p>
          <h2 id="brochure-heading" class="mt-5 text-[clamp(1.6rem,3vw,2.3rem)] leading-[1.1]">
            The capability statement.
          </h2>
          <p class="mt-4 max-w-xl leading-relaxed text-ink-soft">
            A single document covering service lines, sector experience,
            accreditations and the tooling we work in — suitable for circulating
            to a procurement or technical review team.
          </p>
          <p class="mt-4 text-sm text-ink-muted">
            Sent by email, usually the same working day.
          </p>
        </div>

        <div class="reveal lg:col-span-5" style="--i:1">
          {/* Rendered as a request rather than a download, because no brochure
              PDF has been supplied yet. Drop one at public/brochure.pdf and
              swap this block for a direct download link. */}
          <div class="rounded-xl border border-line bg-brand-50/50 p-6">
            <div class="flex items-start gap-4">
              <span class="grid h-12 w-12 shrink-0 place-items-center rounded-lg bg-brand text-white" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 16 16" fill="none">
                  <path d="M3.5 2.5h6L13 6v7.5h-9.5v-11Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" />
                  <path d="M9.3 2.6V6h3.5" stroke="currentColor" stroke-width="1.3" />
                  <path d="M8 8v3.4M6.4 9.9 8 11.5l1.6-1.6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
              <div class="min-w-0">
                <p class="font-display text-sm font-bold text-ink">PowSys capability statement</p>
                <p class="mt-1 text-xs text-ink-muted">PDF · sent by email</p>
              </div>
            </div>

            <div class="mt-5">
              <SiteForm
                id="brochure-form"
                endpoint={FORM_ENDPOINTS.contact}
                subject="Brochure request — powsysengineering.com"
                submitLabel="Send me the brochure"
                fields={[
                  { name: 'name', label: 'Full name', required: true, full: true },
                  { name: 'email', label: 'Work email', type: 'email', required: true, full: true },
                  { name: 'company', label: 'Company', full: true },
                ]}
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =====================================================================
       SUBSCRIBE
  ====================================================================== -->
  <section id="subscribe" class="relative scroll-mt-28 pb-24 lg:pb-32">
    <div class="mx-auto max-w-7xl px-5 lg:px-8">
      <div
        class="reveal relative isolate overflow-hidden rounded-[28px] px-6 py-14 lg:px-14 lg:py-16"
        style="background: linear-gradient(135deg, #14357B 0%, #1A4194 45%, #2B57B0 100%);"
      >
        <div
          class="pointer-events-none absolute -right-24 -top-24 h-[26rem] w-[26rem] rounded-full opacity-45 blur-3xl"
          style="background: radial-gradient(circle, rgba(176,208,56,0.75) 0%, transparent 65%);"
          aria-hidden="true"
        >
        </div>

        <div class="relative grid gap-10 lg:grid-cols-12 lg:items-center lg:gap-12">
          <div class="lg:col-span-6">
            <p class="font-display text-[0.72rem] font-bold uppercase tracking-[0.16em] text-lime">
              Subscribe
            </p>
            <h2 class="mt-4 text-[clamp(1.7rem,3.4vw,2.6rem)] leading-[1.08] text-white">
              Technical writing, not marketing email.
            </h2>
            <p class="mt-4 max-w-lg leading-relaxed text-brand-100">
              New Knowledge Centre articles, guides and field notes as they are
              published — arc flash and CSA Z462, partial discharge testing,
              hazardous area compliance, condition-based maintenance.
            </p>

            <ul class="mt-6 space-y-2">
              {[
                'Roughly monthly, never more than fortnightly',
                'Written by engineers, not a content agency',
                'Unsubscribe in one click',
              ].map((point) => (
                <li class="flex items-center gap-2.5 text-sm text-brand-100">
                  <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-lime" aria-hidden="true"></span>
                  {point}
                </li>
              ))}
            </ul>
          </div>

          <div class="lg:col-span-6">
            <div class="rounded-2xl bg-white p-6 lg:p-7">
              <SiteForm
                id="subscribe-form"
                endpoint={FORM_ENDPOINTS.subscribe}
                subject="Subscription request — powsysengineering.com"
                submitLabel="Subscribe"
                note="No third-party sharing."
                fields={[
                  { name: 'name', label: 'Full name', full: true },
                  { name: 'email', label: 'Work email', type: 'email', required: true, full: true },
                  {
                    name: 'interest',
                    label: 'Most relevant to you',
                    type: 'select',
                    full: true,
                    options: [
                      'All topics',
                      'Compliance & standards',
                      'Reliability & maintenance',
                      'Renewables & interconnection',
                      'Oil & gas',
                      'Data centres',
                    ],
                  },
                ]}
              />

              <p class="mt-4 text-xs leading-relaxed text-ink-muted">
                By subscribing you agree to receive technical publications from
                {' '}{site.legalName} — unsubscribe at any time.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
