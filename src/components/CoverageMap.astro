---
/* ---------------------------------------------------------------------------
   COVERAGE MAP

   Inline SVG. The country outlines come from Natural Earth (public domain) via
   scripts/build-map.mjs, and markers are plotted with the same Albers
   projection, so the dots sit in geographically correct positions.

   No mapping library, no tile server, no runtime request — the whole thing is
   about 15 KB of path data that gzips down hard.
--------------------------------------------------------------------------- */
import { MAP_WIDTH, MAP_HEIGHT, MAP_PATHS, project } from '../data/na-map';
import { mapMarkers } from '../data/content';

const markers = mapMarkers.map((m) => ({ ...m, ...project(m.lon, m.lat) }));
---

<figure class="card overflow-hidden p-4 sm:p-6">
  <svg
    viewBox={`0 0 ${MAP_WIDTH} ${MAP_HEIGHT}`}
    class="h-auto w-full"
    role="img"
    aria-labelledby="map-title map-desc"
  >
    <title id="map-title">Map of PowSys Engineering locations in North America</title>
    <desc id="map-desc">
      Outline map of Canada and the United States marking the Calgary, Alberta
      head office and project locations in Lloydminster, Alberta and Louisiana.
      The same locations are listed as text beside this map.
    </desc>

    <defs>
      <linearGradient id="map-land" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="var(--color-brand-100)" />
        <stop offset="100%" stop-color="var(--color-brand-50)" />
      </linearGradient>
    </defs>

    {/* Mexico sits behind, faint, purely for geographic context */}
    <path d={MAP_PATHS.mexico} fill="var(--color-paper-tint)" stroke="var(--color-line)" stroke-width="1" />

    <path
      d={MAP_PATHS.usa}
      fill="url(#map-land)"
      stroke="var(--color-brand-400)"
      stroke-width="1.3"
      stroke-linejoin="round"
    />
    <path
      d={MAP_PATHS.canada}
      fill="url(#map-land)"
      stroke="var(--color-brand-400)"
      stroke-width="1.3"
      stroke-linejoin="round"
    />

    {/* Markers */}
    {markers.map((m, i) => (
      <g class="map-marker" style={`--i:${i}`}>
        {m.kind === 'office' && (
          <circle class="map-pulse" cx={m.x} cy={m.y} r="9" fill="var(--color-brand)" opacity="0.28" />
        )}

        <circle
          cx={m.x}
          cy={m.y}
          r={m.kind === 'office' ? 8 : 6.5}
          fill={m.kind === 'office' ? 'var(--color-brand)' : 'var(--color-lime-600)'}
          stroke="#fff"
          stroke-width="2.5"
        />

        <text
          x={m.x + m.labelDx}
          y={m.y + m.labelDy}
          text-anchor={m.labelAnchor}
          font-family="var(--font-display)"
          font-size="17"
          font-weight="700"
          fill="var(--color-ink)"
        >{m.name}</text>

        <text
          x={m.x + m.labelDx}
          y={m.y + m.labelDy + 18}
          text-anchor={m.labelAnchor}
          font-family="var(--font-sans)"
          font-size="14"
          fill="var(--color-ink-muted)"
        >{m.note}</text>
      </g>
    ))}
  </svg>

  <figcaption class="mt-4 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-xs text-ink-muted">
    <span class="inline-flex items-center gap-2">
      <span class="h-2.5 w-2.5 rounded-full bg-brand" aria-hidden="true"></span>
      Head office
    </span>
    <span class="inline-flex items-center gap-2">
      <span class="h-2.5 w-2.5 rounded-full bg-lime-600" aria-hidden="true"></span>
      Published project location
    </span>
  </figcaption>
</figure>

<style>
  /* Markers fade in on load, staggered. Visible by default if animation is
     unsupported or reduced — the dots are the content, not decoration. */
  @media (prefers-reduced-motion: no-preference) {
    .map-marker {
      animation: marker-in 0.5s var(--ease-out-soft) both;
      animation-delay: calc(var(--i) * 160ms + 200ms);
      transform-origin: center;
      transform-box: fill-box;
    }

    .map-pulse {
      animation: marker-pulse 2.8s ease-out infinite;
      transform-origin: center;
      transform-box: fill-box;
    }
  }

  @keyframes marker-in {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  @keyframes marker-pulse {
    0%        { transform: scale(1);   opacity: 0.32; }
    70%, 100% { transform: scale(2.6); opacity: 0; }
  }
</style>
