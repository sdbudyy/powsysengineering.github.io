---
import { withBase } from '../lib/url';
/* Compact past-project card used inside a service or industry section.
   The title links through to the full case study on the projects page; the
   scope still expands in place for anyone who does not want to leave. */
import type { projects } from '../data/content';

interface Props {
  project: (typeof projects)[number];
  /** Unique id, since the same project can appear under several services. */
  panelId: string;
}

const { project, panelId } = Astro.props;
---

<article class="card p-5">
  <div class="flex flex-wrap items-center gap-2">
    <span class="rounded-full border border-lime-100 bg-lime-50 px-2.5 py-1 text-[0.66rem] font-bold uppercase tracking-[0.09em] text-lime-deep">
      {project.category}
    </span>
    <span class="inline-flex items-center gap-1 text-[0.72rem] text-ink-muted">
      <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true" class="text-brand">
        <path d="M8 14.5s5-4.2 5-8a5 5 0 0 0-10 0c0 3.8 5 8 5 8Z" stroke="currentColor" stroke-width="1.4" />
        <circle cx="8" cy="6.5" r="1.8" stroke="currentColor" stroke-width="1.4" />
      </svg>
      {project.location}
    </span>
  </div>

  <h4 class="mt-3 font-display text-base font-bold">
    <a
      href={withBase(`/projects#project-${project.slug}`)}
      class="link-draw relative text-ink transition-colors hover:text-brand"
    >
      {project.title}
    </a>
  </h4>
  <p class="mt-2 text-sm leading-relaxed text-ink-soft">{project.detail}</p>

  <div class="expando" id={panelId} data-open="false">
    <div>
      <div class="mt-4 border-t border-line-soft pt-4">
        <p class="font-display text-[0.68rem] font-bold uppercase tracking-[0.13em] text-brand">
          Scope of work
        </p>
        <ul class="mt-2.5 space-y-2">
          {project.scope.map((item) => (
            <li class="flex gap-2.5 text-sm text-ink-soft">
              <span class="mt-[0.45rem] h-1.5 w-1.5 shrink-0 rounded-full bg-lime" aria-hidden="true"></span>
              <span>{item}</span>
            </li>
          ))}
        </ul>

        <ul class="mt-4 flex flex-wrap gap-2">
          {project.tools.map((t) => (
            <li class="rounded-full border border-line bg-white px-2.5 py-1 text-[0.7rem] font-medium text-ink-soft">
              {t}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>

  <button
    type="button"
    data-expands={panelId}
    data-label-closed="Scope"
    data-label-open="Hide scope"
    aria-expanded="false"
    class="mt-4 inline-flex items-center gap-1.5 rounded-lg border border-line px-3 py-1.5 text-[0.72rem] font-semibold text-brand transition-all duration-300 hover:border-brand-200 hover:bg-brand-50"
  >
    <span data-label>Scope</span>
    <svg class="chev" width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true">
      <path d="M2.5 4.5 6 8l3.5-3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>
</article>
