---
/* Static poster card linking to the interactive warehouse on the BCMI page.
   No script, no 3D — a 1 KB SVG and a link, so it can sit on any page
   without touching that page's performance. */
import { withBase } from '../lib/url';

interface Props {
  /** Reveal stagger index. */
  i?: number;
}
const { i = 2 } = Astro.props;
const href = withBase('/services/bcmi/#warehouse');
---

<a
  href={href}
  class="reveal card group grid overflow-hidden sm:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)]"
  style={`--i:${i}`}
>
  <div class="relative aspect-[16/10] bg-brand-50 sm:aspect-auto sm:min-h-[200px]">
    <svg class="absolute inset-0 h-full w-full transition-transform duration-500 group-hover:scale-[1.03]" viewBox="0 0 800 450" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <defs><linearGradient id="iwt-pg" x1="0" x2="1" y1="0" y2="1"><stop offset="0" stop-color="#EEF3FC"/><stop offset="1" stop-color="#E3EAF5"/></linearGradient></defs>
      <rect width="800" height="450" fill="url(#iwt-pg)"/>
      <g fill="none" stroke="#1A4194" stroke-width="2" stroke-linejoin="round" opacity=".55">
        <polygon points="160,300 470,390 720,270 410,190" fill="#F3F7FD"/>
        <polyline points="160,300 160,180 410,80 720,160 720,270"/><polyline points="410,80 410,190"/>
        <line x1="205" y1="196" x2="455" y2="98"/><line x1="255" y1="212" x2="505" y2="114"/><line x1="305" y1="228" x2="555" y2="130"/><line x1="355" y1="244" x2="605" y2="146"/>
        <polyline points="470,390 470,290 720,170" opacity=".5"/>
      </g>
      <g fill="#B0D038" opacity=".9"><circle cx="318" cy="166" r="6"/><circle cx="415" cy="120" r="6"/><circle cx="560" cy="150" r="6"/><circle cx="240" cy="250" r="6"/><circle cx="640" cy="240" r="6"/><circle cx="480" cy="300" r="6"/></g>
    </svg>
    <span class="absolute left-4 top-4 rounded-full bg-brand px-3 py-1 font-display text-[0.68rem] font-bold uppercase tracking-[0.12em] text-white">
      Interactive 3D
    </span>
  </div>
  <div class="p-6 lg:p-7">
    <p class="eyebrow">See it working</p>
    <h3 class="mt-3 text-[1.3rem] leading-[1.15]">Watch a warehouse get instrumented.</h3>
    <p class="mt-3 text-[0.95rem] leading-relaxed text-ink-soft">
      Six building systems, one working floor. Instrument them one at a time and watch the lighting follow the forklifts, the readouts come alive, and the building become measurable.
    </p>
    <span class="link-draw mt-5 inline-flex items-center gap-2 font-semibold text-brand">
      Explore the warehouse <span aria-hidden="true">→</span>
    </span>
  </div>
</a>
