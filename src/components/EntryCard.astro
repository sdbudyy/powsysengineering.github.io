---
import { withBase } from '../lib/url';
/* A single Knowledge Centre entry card.
   Every card carries the two things each entry must show: the type label
   (Article / Opinion / Guide / …) and the read length. */
import { typeStyles, formatDate, type Entry } from '../data/knowledge';

interface Props {
  entry: Entry;
  /** Compact variant drops the date line — used in tight grids. */
  compact?: boolean;
}

const { entry, compact = false } = Astro.props;
---

<article
  class="card group flex h-full flex-col p-6"
  data-category={entry.category}
  data-type={entry.type}
>
  {/* Label point */}
  <div class="flex flex-wrap items-center gap-2">
    <span
      class={`rounded-full border px-2.5 py-1 text-[0.68rem] font-bold uppercase tracking-[0.09em] ${typeStyles[entry.type]}`}
    >
      {entry.type}
    </span>
    <span class="rounded-full border border-line bg-white/70 px-2.5 py-1 text-[0.68rem] font-semibold text-ink-soft">
      {entry.category}
    </span>
  </div>

  <h3 class="mt-4 font-display text-lg font-bold leading-snug">
    <a
      href={withBase(`/knowledge-centre/${entry.slug}`)}
      class="text-ink transition-colors after:absolute after:inset-0 group-hover:text-brand"
    >
      {entry.title}
    </a>
  </h3>

  <p class="mt-3 flex-1 text-sm leading-relaxed text-ink-soft">{entry.excerpt}</p>

  {/* Read length */}
  <div class="mt-5 flex items-center justify-between gap-4 border-t border-line-soft pt-4">
    <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-brand">
      <svg width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <circle cx="8" cy="8" r="6.4" stroke="currentColor" stroke-width="1.4" />
        <path d="M8 4.6V8l2.3 1.4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
      </svg>
      {entry.readMinutes} min read
    </span>

    {!compact && (
      <time datetime={entry.date} class="text-xs text-ink-muted">
        {formatDate(entry.date)}
      </time>
    )}
  </div>
</article>

<style>
  /* The title link stretches over the whole card, so the card needs to be the
     positioning context for it. */
  article {
    position: relative;
  }
</style>
