---
import { withBase } from '../lib/url';
import { site, nav } from '../data/site';
import Logo from './Logo.astro';
const path = Astro.url.pathname;
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 transition-all duration-500 ease-[cubic-bezier(0.22,1,0.36,1)]"
>
  <div
    id="header-inner"
    class="mx-auto flex max-w-7xl items-center gap-6 px-5 py-4 transition-all duration-500 lg:px-8"
  >
    <a href={withBase('/')} class="shrink-0 transition-transform duration-300 hover:scale-[1.03]" aria-label={`${site.name} — home`}>
      <Logo height={42} />
    </a>

    <nav class="ml-auto hidden items-center gap-1 lg:flex" aria-label="Primary">
      {nav.map((item) => (
        <a
          href={withBase(item.href)}
          aria-current={path.startsWith(item.href) ? 'page' : undefined}
          class="link-draw relative rounded-md px-3.5 py-2 text-sm font-medium text-ink-soft transition-colors hover:text-brand aria-[current=page]:text-brand"
        >
          {item.label}
        </a>
      ))}

      <a
        href={withBase('/contact')}
        class="group relative ml-3 overflow-hidden rounded-lg bg-brand px-5 py-2.5 text-sm font-semibold text-white shadow-[0_6px_20px_-8px_rgba(26,65,148,0.7)] transition-all duration-300 hover:shadow-[0_10px_28px_-8px_rgba(26,65,148,0.8)]"
      >
        {/* Lime sheen sweeps across on hover */}
        <span
          class="absolute inset-0 -translate-x-full bg-gradient-to-r from-transparent via-lime/45 to-transparent transition-transform duration-700 group-hover:translate-x-full"
          aria-hidden="true"
        ></span>
        <span class="relative">Get in touch</span>
      </a>
    </nav>

    <button
      id="nav-toggle"
      type="button"
      class="ml-auto grid h-11 w-11 place-items-center rounded-lg border border-line bg-white/80 text-ink transition-colors hover:border-brand-200 lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label="Open menu"
    >
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
      </svg>
    </button>
  </div>

  <!-- Mobile panel -->
  <div id="mobile-nav" hidden class="border-t border-line bg-white/95 px-5 pb-6 pt-2 backdrop-blur lg:hidden">
    <nav class="flex flex-col" aria-label="Primary mobile">
      {nav.map((item) => (
        <a href={withBase(item.href)} class="border-b border-line-soft py-3.5 text-base font-medium text-ink">
          {item.label}
        </a>
      ))}
      <a
        href={withBase('/contact')}
        class="mt-5 rounded-lg bg-brand px-4 py-3 text-center text-base font-semibold text-white"
      >
        Get in touch
      </a>
      <a href={`tel:${site.phoneRaw}`} class="mt-3 text-center text-sm font-medium text-brand">
        {site.phone}
      </a>
    </nav>
  </div>
</header>

<script>
  // Header condenses and gains a frosted backdrop once the page is scrolled.
  const header = document.getElementById('site-header')!;
  const inner = document.getElementById('header-inner')!;
  const toggle = document.getElementById('nav-toggle')!;
  const panel = document.getElementById('mobile-nav')!;

  const onScroll = () => {
    const scrolled = window.scrollY > 20;
    header.classList.toggle('bg-white/85', scrolled);
    header.classList.toggle('backdrop-blur-xl', scrolled);
    header.classList.toggle('shadow-[0_1px_0_0_rgba(227,234,245,1),0_10px_30px_-24px_rgba(14,27,51,0.5)]', scrolled);
    inner.classList.toggle('py-2.5', scrolled);
    inner.classList.toggle('py-4', !scrolled);
  };
  onScroll();
  addEventListener('scroll', onScroll, { passive: true });

  toggle.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    toggle.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
    panel.hidden = open;
  });
</script>
