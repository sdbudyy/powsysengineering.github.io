---
import { withBase } from '../lib/url';
/* Compact Knowledge Centre link used inside a service section. */
import { typeStyles, type Entry } from '../data/knowledge';

interface Props { entry: Entry }
const { entry } = Astro.props;
---

<a
  href={withBase(`/knowledge-centre/${entry.slug}`)}
  class="group flex items-start gap-4 rounded-xl border border-line bg-white/70 p-4 transition-all duration-300 hover:-translate-y-0.5 hover:border-brand-200 hover:bg-white hover:shadow-[0_12px_28px_-16px_rgba(26,65,148,0.35)]"
>
  <span
    class="mt-0.5 grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-brand-50 text-brand transition-colors duration-300 group-hover:bg-brand group-hover:text-white"
    aria-hidden="true"
  >
    <svg width="15" height="15" viewBox="0 0 16 16" fill="none">
      <path d="M3 2.5h6.5L13 6v7.5H3v-11Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" />
      <path d="M9.3 2.6V6H12.8M5.3 9h5.4M5.3 11h3.6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
    </svg>
  </span>

  <span class="min-w-0">
    <span class="flex flex-wrap items-center gap-2">
      <span
        class={`rounded-full border px-2 py-0.5 text-[0.62rem] font-bold uppercase tracking-[0.08em] ${typeStyles[entry.type]}`}
      >
        {entry.type}
      </span>
      <span class="inline-flex items-center gap-1 text-[0.68rem] font-semibold text-ink-muted">
        <svg width="11" height="11" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <circle cx="8" cy="8" r="6.4" stroke="currentColor" stroke-width="1.5" />
          <path d="M8 4.6V8l2.3 1.4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
        {entry.readMinutes} min
      </span>
    </span>

    <span class="mt-1.5 block text-sm font-semibold leading-snug text-ink transition-colors group-hover:text-brand">
      {entry.title}
    </span>
  </span>
</a>
